{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:4500/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://upward.goodtenants.io"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://upward.goodtenants.io/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://upward.goodtenants.io"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://upward-web.vercel.app/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://upward-web.vercel.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://upward.goodtenants.io/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://upward.goodtenants.io"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
