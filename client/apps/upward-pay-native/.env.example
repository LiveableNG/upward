# ─── Local development ───────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://127.0.0.1:4500/api/v1
EXPO_PUBLIC_WEB_URL=https://upward.goodtenants.io

# ─── Google Sign-In (required for production / EAS builds) ─────────────────
# Create three OAuth clients in Google Cloud (same project as API):
#   • Web client     → EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID (also used as webClientId on Android)
#   • iOS client     → EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID (bundle: com.goodtenants.upward)
#   • Android client → EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID (package: com.goodtenants.upward)
#
# API must allow all three in GOOGLE_CLIENT_ID (comma-separated). See server/apps/api/.env.example.
#
# Authorized redirect URIs (Web client + native flow):
#   goodtenants:/oauth/google
#   (Dev) Expo Go may also show a https://auth.expo.io/... URI in Metro logs — add if testing in Go.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# ─── Apple Sign-In ───────────────────────────────────────────────────────────
# Enabled on iOS when bundle com.goodtenants.upward has Sign in with Apple in Apple Developer.
# API APPLE_CLIENT_ID must include com.goodtenants.upward (see server/apps/api/.env.example).
# EXPO_PUBLIC_APPLE_AUTH_ENABLED=false

# ─── EAS (optional locally; set in EAS Secrets for cloud builds) ─────────────
# After `pnpm exec eas init`, project id is stored in app.config / EAS dashboard.
# EAS_PROJECT_ID=
