{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "MAILGUN_API_KEY",
    "MAILGUN_DOMAIN",
    "EMAIL_FROM",
    "DATABASE_URL",
    "FRONTEND_URL",
    "JWT_SECRET",
    "JWT_REFRESH_SECRET",
    "ADMIN_SITE_URL",
    "CRON_SECRET",
    "NODE_ENV",
    "BUGSNAG_API_KEY",
    "DATABASE_URL_TEST"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "prisma:generate": {
      "cache": true
    }
  }
}
