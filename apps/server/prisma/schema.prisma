// This is the Prisma schema file for the Upward platform.
// Database provider: PostgreSQL
// Table prefix convention: upward_

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model upward_waitlist {
  id              String    @id @default(cuid())
  email           String    @unique
  firstName       String?
  lastName        String?
  phone           String?
  role            String?
  benefits        String[]
  acceptTerms     Boolean   @default(false)
  wantsAmbassador Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
  @@index([createdAt])
}
