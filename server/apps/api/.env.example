NODE_ENV=development
PORT=4000

# Database — local dev uses upward_dev; production uses upward
# macOS Homebrew: postgresql://YOUR_OS_USER@localhost:5432/upward_dev
# Docker/Linux:   postgresql://postgres:1234@localhost:5432/upward_dev
DATABASE_URL=postgresql://postgres:1234@localhost:5432/upward_dev
REDIS_URL=redis://localhost:6379

# Auth secrets — use long random values in production!
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CRON_SECRET=your-cron-secret

# Encryption (256-bit hex key for PII fields)
ENCRYPTION_KEY=your-64-char-hex-encryption-key
ENCRYPTION_IV_LENGTH=16

# Local frontend URLs (comma-separated for CORS)
FRONTEND_URL=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173
PM_APP_URL=http://localhost:3002
PAY_APP_URL=http://localhost:3001

# Google OAuth — must match upward-pay NEXT_PUBLIC_GOOGLE_CLIENT_ID (Web client ID)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Paystack (test key)
PAYSTACK_SECRET_KEY=sk_test_your_key

# Mailgun
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.example.com
EMAIL_FROM="Upward <noreply@example.com>"

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=your-bucket-name

# Firebase Cloud Messaging
FCM_PROJECT_ID=your-project-id
FCM_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# CreditChek sandbox — set true to bypass real API calls in dev
CREDIT_CHEK_TEST=true
