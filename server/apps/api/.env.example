NODE_ENV=development
PORT=4000

# Database — local dev uses upward_dev; production uses upward
# macOS Homebrew: postgresql://YOUR_OS_USER@localhost:5432/upward_dev
# Docker/Linux:   postgresql://postgres:1234@localhost:5432/upward_dev
DATABASE_URL=postgresql://postgres:1234@localhost:5432/upward_dev
REDIS_URL=redis://localhost:6379
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain
EMAIL_FROM="Upward by GoodTenants <noreply@goodtenants.io>"

# Database Configuration (Local PostgreSQL active by default)
DATABASE_URL=postgresql://postgres:Oluwaseun123@localhost:6006/upward
#DATABASE_URL=postgresql://username:password@host:port/database_name

# Auth secrets — use long random values in production!
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CRON_SECRET=your-cron-secret
# Schedule Kernel (Africa/Lagos). Set DISABLE_INTERNAL_CRON=true only if an
# external crontab drives /api/v1/public/cron/run instead.
SCHEDULE_TIMEZONE=Africa/Lagos
# DISABLE_INTERNAL_CRON=true

# Encryption (256-bit hex key for PII fields)
ENCRYPTION_KEY=your-64-char-hex-encryption-key
ENCRYPTION_IV_LENGTH=16

# Local frontend URLs (comma-separated for CORS)
FRONTEND_URL=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173
PM_APP_URL=http://localhost:3002
PAY_APP_URL=http://localhost:3001

# Google OAuth — must match upward-pay NEXT_PUBLIC_GOOGLE_CLIENT_ID (Web client ID)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Paystack (test key)
PAYSTACK_SECRET_KEY=sk_test_your_key

# Mailgun
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.example.com
EMAIL_FROM="Upward <noreply@example.com>"

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=your-bucket-name

# Firebase Cloud Messaging
FCM_PROJECT_ID=your-project-id
FCM_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# CreditChek sandbox — set true to bypass real API calls in dev
CRON_SECRET=ab54714d7103723bafdfbd3a

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=upward-stories-storage-2025
PAYSTACK_SECRET_KEY=your-paystack-secret-key
production_encryption_key=your-production-encryption-key
ENCRYPTION_KEY=d7f3e2a1b0c9d8e7f6a5b4c3d2e1f0a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8
ENCRYPTION_IV_LENGTH=16

# FCM Configuration
FCM_PROJECT_ID="upward-by-gt"
FCM_CLIENT_EMAIL="firebase-adminsdk-fbsvc@upward-by-gt.iam.gserviceaccount.com"
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-multiline-firebase-private-key\n-----END PRIVATE KEY-----\n"

# Application URLs (Local Development Ports)
FRONTEND_URL=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
PM_APP_URL=http://localhost:3002
PAY_APP_URL=http://localhost:3001
ADMIN_SITE_URL=http://localhost:3003

# CreditChek Sandbox / Test mode (Set to true to bypass API check using test BVNs)
CREDIT_CHEK_TEST=true

# Email open tracking — public API origin used in tracking pixel URLs
API_BASE_URL=http://localhost:4000

# WhatsApp Cloud API
WHATSAPP_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
# Meta webhook verify token (must match what you set in Meta Developer Console)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-random-verify-token
