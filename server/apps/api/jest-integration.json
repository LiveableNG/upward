{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testRegex": ".*\\.integration\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@domains/(.*)$": "<rootDir>/src/domains/$1",
    "^@application/(.*)$": "<rootDir>/src/application/$1",
    "^@interfaces/(.*)$": "<rootDir>/src/interfaces/$1",
    "^@shared/(.*)$": "<rootDir>/src/shared/$1"
  }
}
