model upward_property_manager {
  id              Int                         @id @default(autoincrement())
  uuid            String                      @unique @default(uuid())
  email           String                      @unique
  emailHash       String                      @unique
  passwordHash    String
  firstName       String
  firstNameHash   String?
  lastName        String
  lastNameHash    String?
  businessName    String?
  pmType          String?
  phone           String?
  phoneHash       String?
  profilePic      String?
  country         String?
  companyAddress  String?
  cacNumber       String?
  personalEmail   String?
  personalPhone   String?
  resetPasswordOTP String?
  resetPasswordExpires DateTime?
  bankName        String?
  bankCode        String?
  accountNumber   String?
  accountName     String?
  isVerified      Boolean                     @default(false)
  isInternal      Boolean                     @default(false)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  authSessions    upward_pm_auth_session[]
  bulkInvites     upward_pm_bulk_invite[]
  paymentRequests upward_pm_payment_request[]
  properties      upward_pm_property[]
  tenants         upward_pm_tenant[]
  userProperties  upward_user_property[]
  landlordReports upward_pm_landlord_report[]
  sentDocuments   upward_pm_sent_document[]
  documentTemplates upward_pm_document_template[]
  verification    upward_pm_verification?
  emailSetting    upward_pm_email_setting?
  receiptSetting  upward_pm_receipt_setting?
  letterheads     upward_pm_letterhead[]
  signatures      upward_pm_signature[]
  notifications   upward_pm_notification[]
  
  teamOwner         upward_pm_team_collaboration[] @relation("OwnerTeam")
  teamCollaborator  upward_pm_team_collaboration[] @relation("CollaboratorTeam")
  propertyCollaborations upward_pm_property_collaboration[]
  activityLogsPerformed upward_pm_activity_log[] @relation("ActivityPerformer")
  activityLogsOwned     upward_pm_activity_log[] @relation("ActivityOwner")
  bulkImportJobs        upward_pm_bulk_import_job[]

  subscription          upward_subscription?
  wallet                upward_pm_wallet?
  dedicatedVirtualAccount upward_pm_dedicated_virtual_account?
  walletTransactions    upward_pm_wallet_transaction[]
  subscriptionInvoices  upward_subscription_invoice[]
  subscriptionLogs      upward_subscription_log[]

  @@index([email])
}

model upward_pm_letterhead {
  id                         Int                     @id @default(autoincrement())
  uuid                       String                  @unique @default(uuid())
  pmId                       Int
  isDefault                  Boolean                 @default(false)
  pageCount                  Int                     @default(1)
  templateFileKey            String?
  previewFirstPageKey        String?
  previewContinuationPageKey String?
  templateConfig             Json?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  pm                         upward_property_manager @relation(fields: [pmId], references: [id], onDelete: Cascade)

  @@index([pmId])
}

model upward_pm_auth_session {
  id               String                  @id @default(uuid())
  pmId             Int
  refreshTokenHash String                  @unique
  userAgent        String?
  ipAddress        String?
  deviceId         String?
  isRevoked        Boolean                 @default(false)
  expiresAt        DateTime
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  pm               upward_property_manager @relation(fields: [pmId], references: [id], onDelete: Cascade)

  @@index([pmId])
}

model upward_pm_property {
  id                     Int                     @id @default(autoincrement())
  uuid                   String                  @unique @default(uuid())
  pmId                   Int
  name                   String
  address                String?
  totalUnits             Int                     @default(0)
  propertyType           String                  @default("Residential")
  imageUrl               String?
  country                String                  @default("Nigeria")
  state                  String?
  area                   String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  landlordEmailEncrypted String?
  landlordEmailHash      String?
  landlordNameEncrypted  String?
  landlordNameSearch     String?
  landlordPhoneEncrypted String?
  landlordPhoneHash      String?
  pm                     upward_property_manager @relation(fields: [pmId], references: [id], onDelete: Cascade)
  units                  upward_pm_unit[]
  collaborators          upward_pm_property_collaboration[]
  manualAccount          upward_manual_account?

  @@index([pmId])
}

model upward_pm_unit {
  id               Int                         @id @default(autoincrement())
  uuid             String                      @unique @default(uuid())
  propertyId       Int
  unitName         String
  rentAmount       Float                       @default(0)
  rentStartDate    DateTime?
  rentDueDate      DateTime?
  currency         String                      @default("NGN")
  status           String                      @default("VACANT")
  tenantId         Int?
  isSynced         Boolean                     @default(false)
  userPropertyUuid String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  managementFee    Float                       @default(0)
  notes            String?
  rentType         String                      @default("Monthly")
  rentReminderEnabled    Boolean                     @default(false)
  rentReminderDaysBefore Int?                        @db.SmallInt

  
  // New fields for rich unit details
  unitType              String?                     // e.g. Office Space, Apartment, Studio

  // Stores remaining rent balance for deferred PR creation when tenant is not yet synced to Upward Pay
  pendingInitialPrAmount Float?

  paymentRequests  upward_pm_payment_request[]
  rentPayments     upward_pm_rent_payment[]
  sentDocuments    upward_pm_sent_document[]
  property         upward_pm_property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant           upward_pm_tenant?           @relation(fields: [tenantId], references: [id])
  userProperties   upward_user_property[]

  @@index([propertyId])
  @@index([status])
  @@index([tenantId])
}

model upward_pm_tenant {
  id                 Int                         @id @default(autoincrement())
  uuid               String                      @unique @default(uuid())
  pmId               Int
  /// @encrypted
  commercialNameEncrypted String?
  commercialNameSearch    String?
  /// @encrypted
  firstNameEncrypted String?
  firstNameSearch    String?
  /// @encrypted
  lastNameEncrypted  String?
  lastNameSearch     String?
  /// @encrypted
  emailEncrypted     String?
  emailHash          String?
  /// @encrypted
  phoneEncrypted     String?
  phoneHash          String?
  /// @encrypted
  otherPhoneEncrypted String?
  otherPhoneHash      String?
  formerAddress      String?
  nextOfKinName      String?
  nextOfKinEmail     String?
  nextOfKinPhone     String?
  guarantorName      String?
  guarantorEmail     String?
  guarantorPhone     String?
  emergencyContactName String?
  emergencyContactEmail String?
  emergencyContactPhone String?
  inviteStatus       String                      @default("PENDING")
  inviteSentAt       DateTime?
  isInternal         Boolean                     @default(false)
  channel            String?
  hasReceivedWelcomeTemplate Boolean                     @default(false)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  paymentRequests    upward_pm_payment_request[]
  rentPayments       upward_pm_rent_payment[]
  sentDocuments      upward_pm_sent_document[]
  pm                 upward_property_manager     @relation(fields: [pmId], references: [id], onDelete: Cascade)
  units              upward_pm_unit[]

  @@index([pmId])
  @@index([emailHash])
}

model upward_pm_rent_payment {
  id                  Int               @id @default(autoincrement())
  uuid                String            @unique @default(uuid())
  unitId              Int
  amount              Float
  // rent due for this payment's period, snapshotted so later rent reviews don't rewrite past history
  rentAmountAtPayment Float
  paymentDate         DateTime
  periodStart         DateTime?
  periodEnd           DateTime?
  method              String            @default("Bank Transfer")
  reference           String?
  status              String            @default("SUCCESS")
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  unit                upward_pm_unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantId            Int?
  tenant              upward_pm_tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([unitId])
  @@index([tenantId])
  @@index([paymentDate])
}

model upward_pm_payment_request {
  id               Int                     @id @default(autoincrement())
  uuid             String                  @unique @default(uuid())
  pmId             Int
  unitId           Int
  tenantId         Int?
  paymentRequestId Int?
  amount           Float
  currency         String                  @default("NGN")
  description      String?
  dueDate          DateTime
  status           String                  @default("PENDING")
  amountPaid       Float                   @default(0)
  allowPartial     Boolean                 @default(false)
  minAmount        Float?
  rentStartDate    DateTime?
  rentEndDate      DateTime?
  rentType         String?
  reminderFrequency String                  @default("NONE") // NONE, DAILY, EVERY_2_DAYS, WEEKLY
  nextReminderAt   DateTime?
  reminderCount    Int                     @default(0)
  scheduledAt      DateTime?               // Scheduled delivery/activation time
  isRecurring      Boolean                 @default(false)
  recurrenceInterval String?               // e.g. 'MONTHLY', 'QUARTERLY', 'YEARLY'
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  paymentRequest   upward_payment_request? @relation(fields: [paymentRequestId], references: [id])
  pm               upward_property_manager @relation(fields: [pmId], references: [id], onDelete: Cascade)
  tenant           upward_pm_tenant?       @relation(fields: [tenantId], references: [id])
  unit             upward_pm_unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([pmId])
  @@index([unitId])
  @@index([status])
}

model upward_pm_bulk_invite {
  id           String                       @id @default(uuid())
  pmId         Int
  status       String                       @default("PENDING")
  totalTenants Int                          @default(0)
  sentCount    Int                          @default(0)
  failedCount  Int                          @default(0)
  error        String?
  channel      String?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  pm           upward_property_manager      @relation(fields: [pmId], references: [id], onDelete: Cascade)
  items        upward_pm_bulk_invite_item[]

  @@index([pmId])
  @@index([status])
}

model upward_pm_bulk_invite_item {
  id           String                @id @default(uuid())
  bulkInviteId String
  tenantUuid   String
  status       String                @default("PENDING")
  error        String?
  retries      Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  bulkInvite   upward_pm_bulk_invite @relation(fields: [bulkInviteId], references: [id], onDelete: Cascade)

  @@index([bulkInviteId])
  @@index([status])
}

model upward_pm_landlord_report {
  id              Int                     @id @default(autoincrement())
  uuid            String                  @unique @default(uuid())
  pmId            Int
  landlordEmail   String
  reportType      String
  reportData      Json
  createdAt       DateTime                @default(now())
  pm              upward_property_manager @relation(fields: [pmId], references: [id], onDelete: Cascade)

  @@index([pmId])
  @@index([landlordEmail])
}

model upward_pm_verification {
  id              Int                         @id @default(autoincrement())
  pmId            Int                         @unique
  idType          String                      // NIN, BVN, CAC
  idNumber        String
  idImage         String?
  status          String                      @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  pm              upward_property_manager     @relation(fields: [pmId], references: [id], onDelete: Cascade)
}

model upward_pm_email_setting {
  id                Int                     @id @default(autoincrement())
  pmId              Int                     @unique
  senderName        String
  senderEmail       String
  logoUrl           String?
  footerAddress     String?
  cc                String?                 // Comma-separated email addresses
  bcc               String?                 // Comma-separated email addresses
  closingStatement  String?
  domain            String?
  isVerified        Boolean                 @default(false)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  pm                upward_property_manager @relation(fields: [pmId], references: [id], onDelete: Cascade)

  @@index([pmId])
}

model upward_pm_receipt_setting {
  id                Int                     @id @default(autoincrement())
  pmId              Int                     @unique
  logoUrl           String?
  useEmailLogo      Boolean                 @default(true)
  themeColor        String                  @default("#d97757")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  pm                upward_property_manager @relation(fields: [pmId], references: [id], onDelete: Cascade)

  @@index([pmId])
}

model upward_pm_signature {
  id        Int                     @id @default(autoincrement())
  uuid      String                  @unique @default(uuid())
  pmId      Int
  name      String
  type      String                  // 'upload' | 'pad' | 'digital'
  fileKey   String?                 // S3 Key for image/drawn signature files
  content   String?                 // Plain text or stylized HTML for digital signatures
  isDefault Boolean                 @default(false)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  pm        upward_property_manager @relation(fields: [pmId], references: [id], onDelete: Cascade)

  @@index([pmId])
}

model upward_pm_notification {
  id        Int                     @id @default(autoincrement())
  uuid      String                  @unique @default(uuid())
  pmId      Int
  title     String
  message   String
  type      String                  @default("SYSTEM") // PAYMENT_COMPLETED, PAYMENT_DUE, PAYMENT_OVERDUE, SYSTEM
  url       String?
  isRead    Boolean                 @default(false)
  isPopup   Boolean                 @default(false)
  popupSeen Boolean                 @default(false)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  pm        upward_property_manager @relation(fields: [pmId], references: [id], onDelete: Cascade)

  @@index([pmId])
  @@index([isRead])
  @@index([createdAt])
}
