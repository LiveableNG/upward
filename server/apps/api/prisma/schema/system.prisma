model upward_waitlist {
  id                       String              @id @default(uuid())
  uuid                     String              @unique @default(uuid())
  email                    String              @unique
  firstName                String?
  lastName                 String?
  phone                    String?
  role                     String?
  benefits                 String[]
  acceptTerms              Boolean             @default(false)
  wantsAmbassador          Boolean             @default(false)
  country                  String?
  city                     String?
  selectedSession          String?
  isInternal               Boolean             @default(false)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  confirmationSent         Boolean             @default(false)
  abVariant                String?
  confirmationEmailError   String?
  confirmationEmailRetries Int                 @default(0)
  confirmationEmailStatus  String?
  campaignWeekSent         Int                 @default(0)
  unsubscribed             Boolean             @default(false)
  unsubscribedAt           DateTime?
  attendances              upward_attendance[]
  communicationLogs        upward_communication_log[]

  @@index([email])
  @@index([createdAt])
  @@index([confirmationEmailStatus])
}

model upward_session {
  id             String              @id @default(uuid())
  name           String
  googleMeetLink String
  startTime      DateTime
  endTime        DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  attendances    upward_attendance[]
  communicationLogs upward_communication_log[]

  @@index([startTime])
}

model upward_attendance {
  id        String          @id @default(uuid())
  sessionId String
  userId    String
  attended  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  session   upward_session  @relation(fields: [sessionId], references: [id])
  user      upward_waitlist @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

model upward_communication_log {
  id               String           @id @default(uuid())
  userId           String?
  registeredUserId Int?
  sessionId        String?
  subject          String
  sentAt           DateTime?
  status           String
  createdAt        DateTime         @default(now())
  email            String?
  lastError        String?
  mailgunId        String?
  type             String           @default("GENERIC")
  channel          String           @default("EMAIL")
  recipient        String?
  updatedAt        DateTime         @updatedAt
  retries          Int              @default(0)
  body             String?
  emailSequenceLogId Int?
  session          upward_session?  @relation(fields: [sessionId], references: [id])
  user             upward_waitlist? @relation(fields: [userId], references: [id], onDelete: Cascade)
  registeredUser   upward_user?     @relation(fields: [registeredUserId], references: [id], onDelete: Cascade)
  emailSequenceLog upward_email_sequence_log? @relation(fields: [emailSequenceLogId], references: [id], onDelete: SetNull)
  emailTrackingToken String? @unique
  isOpened Boolean @default(false)
  openedAt DateTime?
  openCount Int @default(0)
  userAgent String? @db.Text

  @@map("upward_communication_log")
  @@index([userId])
  @@index([registeredUserId])
  @@index([sessionId])
  @@index([status])
  @@index([type])
  @@index([channel])
  @@index([emailSequenceLogId])
}

model upward_interaction {
  id        String   @id @default(uuid())
  visitorId String
  type      String
  target    String
  abVariant String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  metadata  String?

  @@index([visitorId])
  @@index([type])
  @@index([createdAt])
}

model upward_error_log {
  id        String   @id @default(uuid())
  message   String
  stack     String?
  context   String?
  severity  String   @default("ERROR")
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([severity])
  @@index([resolved])
}

model upward_email_campaign {
  id          String   @id @default(uuid())
  weekNumber  Int      @unique
  subject     String
  htmlContent String
  textContent String?
  label       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([weekNumber])
  @@index([isActive])
}

model upward_system_email {
  id          String   @id @default(uuid())
  slug        String   @unique
  subject     String
  htmlContent String
  textContent String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model upward_fairness_story {
  id         String   @id @default(uuid())
  name       String?
  categories String[]
  story      String
  audioUrl   String?
  fileUrls   String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
}

model upward_announcement {
  id        Int                              @id @default(autoincrement())
  uuid      String                           @unique @default(uuid())
  title     String
  message   String
  iconType  String                           @default("sparkles")
  isActive  Boolean                          @default(true)
  createdAt DateTime                         @default(now())
  updatedAt DateTime                         @updatedAt
  url       String?
  states    upward_user_announcement_state[]

  @@index([isActive])
  @@index([createdAt])
}

model upward_user_announcement_state {
  id               Int                 @id @default(autoincrement())
  uuid             String              @unique @default(uuid())
  userId           Int
  announcementId   Int
  seenPopup        Boolean             @default(false)
  interactedPopup  Boolean             @default(false)
  seenBanner       Boolean             @default(false)
  interactedBanner Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  announcement     upward_announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user             upward_user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([userId])
}

model upward_notification {
  id        Int         @id @default(autoincrement())
  uuid      String      @unique @default(uuid())
  userId    Int
  title     String
  message   String
  type      String      @default("SYSTEM")
  url       String?
  isRead    Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      upward_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model upward_webhook_log {
  id           String           @id @default(uuid())
  platformId   Int?
  event        String
  url          String
  payload      Json
  status       String
  responseCode Int?
  errorMessage String?
  retries      Int              @default(0)
  lastTriedAt  DateTime?
  direction    String           @default("OUTGOING")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  platform     upward_platform? @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId])
  @@index([status])
  @@index([createdAt])
  @@index([direction])
}

model upward_platform {
  id          Int                  @id @default(autoincrement())
  uuid        String               @unique @default(uuid())
  apiKey      String               @unique
  webhookUrl  String
  name        String
  address     String?
  email       String?
  emailHash   String?              @unique
  nameHash    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  companies   upward_company[]
  webhookLogs upward_webhook_log[]
}

model upward_credibility_request {
  id           Int         @id @default(autoincrement())
  uuid         String      @unique @default(uuid())
  userId       Int
  propertyUuid String
  /// @encrypted
  companyName  String?
  /// @encrypted
  managerName  String?
  /// @encrypted
  email        String?
  /// @encrypted
  phone        String?
  status       String      @default("PENDING")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         upward_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyUuid])
  @@index([status])
}

model upward_support_ticket {
  id         Int         @id @default(autoincrement())
  uuid       String      @unique @default(uuid())
  userId     Int
  message    String
  status     String      @default("OPEN")
  resolvedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       upward_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model upward_feedback {
  id        Int          @id @default(autoincrement())
  uuid      String       @unique @default(uuid())
  userId    Int?
  email     String?
  name      String?
  type      String       // BUG, SUGGESTION, DIFFICULTY, OTHER
  message   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      upward_user? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

/// Public website apartment briefs (request-a-home). Contact fields are for outreach.
model upward_home_request {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  email         String
  phone         String
  fullName      String?
  locations     Json // [{ state, area, subArea? }]
  budgetMin     Float
  budgetMax     Float
  propertyType  Json     // string[] — e.g. ["apartment","duplex"]
  beds          Int
  moveInDate    DateTime?
  amenities     Json     @default("[]") // string[]
  notes         String?
  source        String   @default("website")
  status        String   @default("submitted") // submitted | contacted | assigned | closed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contactReveals upward_home_request_contact_reveal[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
}

/// Logs each PM who revealed prospect contact (intent to reach out).
model upward_home_request_contact_reveal {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  homeRequestId Int
  pmId          Int
  createdAt     DateTime @default(now())

  homeRequest upward_home_request @relation(fields: [homeRequestId], references: [id], onDelete: Cascade)

  @@unique([homeRequestId, pmId])
  @@index([pmId])
  @@index([createdAt])
}

/// Aggregated listing price floor/ceiling per location, used to advise
/// prospects on the home-request budget step. subArea/baths are nullable
/// where source data lacked that granularity.
model upward_area_price_guide {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  state      String
  area       String
  subArea    String?
  bedrooms   Int
  baths      Int?
  minPrice   Float
  maxPrice   Float
  sampleSize Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([state, area, subArea, bedrooms, baths])
  @@index([state, area, bedrooms])
}

model upward_app_activity_log {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  app          String   // "upward-pay" or "upward-pm"
  userId       Int?     // Numeric ID of upward_user (if tenant)
  pmId         Int?     // Numeric ID of upward_property_manager (if PM)
  userRole     String   // "TENANT", "PM", "ADMIN", "SYSTEM", "GUEST"
  userEmail    String?
  action       String   // "CREATE", "UPDATE", "DELETE", "LOGIN", "LOGOUT", "SIGNUP", etc.
  entityType   String?  // e.g. "PROPERTY", "UNIT", "TENANT", "PAYMENT", "PROFILE"
  entityId     String?  // ID/UUID of the entity
  description  String   // Human-readable description
  metadata     Json?    // Request payload or additional info
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([app])
  @@index([userId])
  @@index([pmId])
  @@index([userEmail])
  @@index([action])
  @@index([createdAt])
}

model upward_dev_email_preview {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  to          String
  subject     String
  html        String
  text        String?
  attachments Json?
  createdAt   DateTime @default(now())

  @@index([to])
  @@index([createdAt])
}

model upward_blog_post {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  title        String
  slug         String   @unique
  excerpt      String
  contentHtml  String
  coverImageUrl String?
  authorName   String
  status       String   @default("DRAFT")
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([createdAt])
}
