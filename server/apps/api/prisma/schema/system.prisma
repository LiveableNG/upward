model upward_waitlist {
  id                       String                     @id @default(uuid())
  email                    String                     @unique
  firstName                String?
  lastName                 String?
  phone                    String?
  role                     String?
  benefits                 String[]
  acceptTerms              Boolean                    @default(false)
  wantsAmbassador          Boolean                    @default(false)
  country                  String?
  city                     String?
  selectedSession          String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  confirmationSent         Boolean                    @default(false)
  abVariant                String?
  confirmationEmailError   String?
  confirmationEmailRetries Int                        @default(0)
  confirmationEmailStatus  String?
  campaignWeekSent         Int                        @default(0)
  unsubscribed             Boolean                    @default(false)
  unsubscribedAt           DateTime?
  uuid                     String                     @unique @default(uuid())
  isInternal               Boolean                    @default(false)
  attendances              upward_attendance[]
  communicationLogs        upward_communication_log[]

  @@index([email])
  @@index([createdAt])
  @@index([confirmationEmailStatus])
}

model upward_session {
  id                String                     @id @default(uuid())
  name              String
  googleMeetLink    String
  startTime         DateTime
  endTime           DateTime
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  attendances       upward_attendance[]
  communicationLogs upward_communication_log[]

  @@index([startTime])
}

model upward_attendance {
  id        String          @id @default(uuid())
  sessionId String
  userId    String
  attended  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  session   upward_session  @relation(fields: [sessionId], references: [id])
  user      upward_waitlist @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

model upward_communication_log {
  id                 String                     @id @default(uuid())
  userId             String?
  sessionId          String?
  subject            String
  sentAt             DateTime?
  status             String
  createdAt          DateTime                   @default(now())
  email              String?
  lastError          String?
  mailgunId          String?
  type               String                     @default("GENERIC")
  updatedAt          DateTime                   @updatedAt
  retries            Int                        @default(0)
  body               String?
  registeredUserId   Int?
  channel            String                     @default("EMAIL")
  recipient          String?
  emailSequenceLogId Int?
  emailTrackingToken String?                    @unique
  isOpened           Boolean                    @default(false)
  openCount          Int                        @default(0)
  openedAt           DateTime?
  userAgent          String?
  emailSequenceLog   upward_email_sequence_log? @relation(fields: [emailSequenceLogId], references: [id])
  registeredUser     upward_user?               @relation(fields: [registeredUserId], references: [id], onDelete: Cascade)
  session            upward_session?            @relation(fields: [sessionId], references: [id])
  user               upward_waitlist?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailLinks         upward_email_link[]

  @@index([userId])
  @@index([registeredUserId])
  @@index([sessionId])
  @@index([status])
  @@index([type])
  @@index([channel])
  @@index([emailSequenceLogId])
  @@map("upward_communication_log")
}

model upward_email_link {
  id                 String                    @id @default(uuid())
  communicationLogId String
  originalUrl        String
  clickCount         Int                       @default(0)
  firstClickedAt     DateTime?
  lastClickedAt      DateTime?
  createdAt          DateTime                  @default(now())
  communicationLog   upward_communication_log  @relation(fields: [communicationLogId], references: [id], onDelete: Cascade)
  clicks             upward_email_link_click[]

  @@index([communicationLogId])
  @@map("upward_email_link")
}

model upward_email_link_click {
  id          String            @id @default(uuid())
  linkId      String
  clickedAt   DateTime          @default(now())
  ipAddress   String?
  userAgent   String?
  link        upward_email_link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@map("upward_email_link_click")
}


model upward_interaction {
  id        String   @id @default(uuid())
  visitorId String
  type      String
  target    String
  abVariant String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  metadata  String?

  @@index([visitorId])
  @@index([type])
  @@index([createdAt])
}

model upward_error_log {
  id        String   @id @default(uuid())
  message   String
  stack     String?
  context   String?
  severity  String   @default("ERROR")
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([severity])
  @@index([resolved])
}

model upward_email_campaign {
  id          String   @id @default(uuid())
  weekNumber  Int      @unique
  subject     String
  htmlContent String
  textContent String?
  label       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([weekNumber])
  @@index([isActive])
}

model upward_system_email {
  id          String   @id @default(uuid())
  slug        String   @unique
  subject     String
  htmlContent String
  textContent String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model upward_fairness_story {
  id         String   @id @default(uuid())
  name       String?
  categories String[]
  story      String
  audioUrl   String?
  fileUrls   String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
}

model upward_announcement {
  id        Int                              @id @default(autoincrement())
  uuid      String                           @unique @default(uuid())
  title     String
  message   String
  iconType  String                           @default("sparkles")
  isActive  Boolean                          @default(true)
  createdAt DateTime                         @default(now())
  updatedAt DateTime                         @updatedAt
  url       String?
  states    upward_user_announcement_state[]

  @@index([isActive])
  @@index([createdAt])
}

model upward_user_announcement_state {
  id               Int                 @id @default(autoincrement())
  uuid             String              @unique @default(uuid())
  userId           Int
  announcementId   Int
  seenPopup        Boolean             @default(false)
  interactedPopup  Boolean             @default(false)
  seenBanner       Boolean             @default(false)
  interactedBanner Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  announcement     upward_announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user             upward_user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([userId])
}

model upward_notification {
  id        Int         @id @default(autoincrement())
  uuid      String      @unique @default(uuid())
  userId    Int
  title     String
  message   String
  type      String      @default("SYSTEM")
  url       String?
  isRead    Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      upward_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model upward_webhook_log {
  id           String           @id @default(uuid())
  platformId   Int?
  event        String
  url          String
  payload      Json
  status       String
  responseCode Int?
  errorMessage String?
  retries      Int              @default(0)
  lastTriedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  direction    String           @default("OUTGOING")
  platform     upward_platform? @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId])
  @@index([status])
  @@index([createdAt])
  @@index([direction])
}

model upward_platform {
  id          Int                  @id @default(autoincrement())
  uuid        String               @unique @default(uuid())
  apiKey      String               @unique
  webhookUrl  String
  name        String
  address     String?
  email       String?
  emailHash   String?              @unique
  nameHash    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  companies   upward_company[]
  webhookLogs upward_webhook_log[]
}

model upward_credibility_request {
  id           Int         @id @default(autoincrement())
  uuid         String      @unique @default(uuid())
  userId       Int
  propertyUuid String
  /// @encrypted
  companyName  String?
  /// @encrypted
  managerName  String?
  /// @encrypted
  email        String?
  /// @encrypted
  phone        String?
  status       String      @default("PENDING")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         upward_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyUuid])
  @@index([status])
}

model upward_support_ticket {
  id         Int         @id @default(autoincrement())
  uuid       String      @unique @default(uuid())
  userId     Int
  message    String
  status     String      @default("OPEN")
  resolvedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       upward_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model upward_feedback {
  id        Int                     @id @default(autoincrement())
  uuid      String                  @unique @default(uuid())
  userId    Int?
  pmId      Int?
  email     String?
  name      String?
  type      String
  message   String
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  user      upward_user?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  pm        upward_property_manager? @relation(fields: [pmId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([pmId])
  @@index([type])
  @@index([createdAt])
}

/// Public website apartment briefs (request-a-home). Contact fields are for outreach.
model upward_home_request {
  id             Int                                  @id @default(autoincrement())
  uuid           String                               @unique @default(uuid())
  email          String
  phone          String
  fullName       String?
  locations      Json
  budgetMin      Float
  budgetMax      Float
  propertyType   Json
  beds           Int
  moveInDate     DateTime?
  amenities      Json                                 @default("[]")
  notes          String?
  source         String                               @default("website")
  status         String                               @default("submitted")
  createdAt      DateTime                             @default(now())
  updatedAt      DateTime                             @updatedAt
  contactReveals upward_home_request_contact_reveal[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
}

/// Logs each PM who revealed prospect contact (intent to reach out).
model upward_home_request_contact_reveal {
  id            Int                 @id @default(autoincrement())
  uuid          String              @unique @default(uuid())
  homeRequestId Int
  pmId          Int
  createdAt     DateTime            @default(now())
  homeRequest   upward_home_request @relation(fields: [homeRequestId], references: [id], onDelete: Cascade)

  @@unique([homeRequestId, pmId])
  @@index([pmId])
  @@index([createdAt])
}

/// Aggregated listing price floor/ceiling per location, used to advise
/// prospects on the home-request budget step. subArea/baths are nullable
/// where source data lacked that granularity.
model upward_area_price_guide {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  state      String
  area       String
  subArea    String?
  bedrooms   Int
  baths      Int?
  minPrice   Float
  maxPrice   Float
  sampleSize Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([state, area, subArea, bedrooms, baths])
  @@index([state, area, bedrooms])
}

model upward_app_activity_log {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  app         String
  userId      Int?
  pmId        Int?
  userRole    String
  userEmail   String?
  action      String
  entityType  String?
  entityId    String?
  description String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([app])
  @@index([userId])
  @@index([pmId])
  @@index([userEmail])
  @@index([action])
  @@index([createdAt])
}

model upward_dev_email_preview {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  to          String
  subject     String
  html        String
  text        String?
  createdAt   DateTime @default(now())
  attachments Json?
  bcc         String?
  cc          String?
  from        String?

  @@index([to])
  @@index([createdAt])
}

model upward_blog_post {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(uuid())
  title         String
  slug          String    @unique
  excerpt       String
  contentHtml   String
  coverImageUrl String?
  authorName    String
  status        String    @default("DRAFT")
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([createdAt])
}

model upward_demo_request {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  name      String
  email     String
  phone     String
  tenants   String
  demoDate  DateTime
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
}

model upward_early_access {
  id              String   @id @default(uuid())
  type            String   // STUDENT | LANDLORD
  name            String
  whatsapp        String
  email           String?
  city            String
  ageBracket      String?  // Student specific
  experienceLevel String?  // Student specific
  interest        String?  // Student specific
  propertyCount   String?  // Landlord specific
  landlordStatus  String?  // Landlord specific
  managementStyle String?  // Landlord specific
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([type])
  @@index([email])
  @@index([whatsapp])
  @@index([createdAt])
}

model upward_university_application {
  id              String   @id @default(uuid())
  name            String
  whatsapp        String
  email           String
  city            String
  ageBracket      String
  occupation      String?
  experienceLevel String?
  goals           String?
  commitment      String
  why             String
  timing          String?
  isScholarship   Boolean  @default(false)
  scholarshipVideoUrl String?
  status          String   @default("SUBMITTED") // SUBMITTED | REVIEWED | ADMITTED | REJECTED | FEE_PAID | REFUNDED
  applicationFee  Float    @default(5000.0)
  feeStatus       String   @default("PENDING") // PENDING | PAID | REFUNDED
  paymentRef      String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
  @@index([whatsapp])
  @@index([status])
  @@index([feeStatus])
  @@index([createdAt])
}

