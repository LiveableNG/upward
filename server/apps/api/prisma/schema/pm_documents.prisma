model upward_pm_document_template {
  id        Int                     @id @default(autoincrement())
  uuid      String                  @unique @default(uuid())
  pmId      Int
  name      String
  content   String
  type      String                  @default("CUSTOM")
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  pm        upward_property_manager @relation(fields: [pmId], references: [id], onDelete: Cascade)

  @@index([pmId])
}

model upward_pm_sent_document {
  id                Int                     @id @default(autoincrement())
  uuid              String                  @unique @default(uuid())
  pmId              Int
  tenantId          Int?
  unitId            Int?
  subject           String
  content           String
  documentType      String                  @default("PDF")
  recipientName     String
  recipientEmail    String
  status            String                  @default("SENT")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  includeLetterhead Boolean                 @default(false)
  isVaultDocument   Boolean                 @default(false)
  paymentRequestId  Int?
  pm                upward_property_manager @relation(fields: [pmId], references: [id], onDelete: Cascade)
  tenant            upward_pm_tenant?       @relation(fields: [tenantId], references: [id])
  unit              upward_pm_unit?         @relation(fields: [unitId], references: [id])

  @@index([pmId])
  @@index([tenantId])
  @@index([unitId])
  @@index([recipientEmail])
  @@index([isVaultDocument])
}

model upward_pm_bulk_import_job {
  id                 Int                         @id @default(autoincrement())
  uuid               String                      @unique @default(uuid())
  pmId               Int
  targetPropertyUuid String?
  mode               String                      @default("full")
  originalFileName   String
  fileUrl            String
  fileType           String
  status             String                      @default("PENDING_ASSIGNMENT")
  assignedAdminId    String?
  assignedAdminName  String?
  assignedAdminEmail String?
  stagedRowsJson     String?
  unitsCreated       Int                         @default(0)
  propertiesCreated  Int                         @default(0)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  assignedAdmin      upward_admin?               @relation(fields: [assignedAdminId], references: [id])
  pm                 upward_property_manager     @relation(fields: [pmId], references: [id], onDelete: Cascade)
  logs               upward_pm_bulk_import_log[]

  @@index([pmId])
  @@index([assignedAdminId])
  @@index([status])
}

model upward_pm_bulk_import_log {
  id         Int                       @id @default(autoincrement())
  jobId      Int
  adminId    String?
  adminEmail String?
  action     String
  details    String?
  createdAt  DateTime                  @default(now())
  job        upward_pm_bulk_import_job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}
