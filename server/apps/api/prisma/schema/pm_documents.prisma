
model upward_pm_document_template {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  pmId      Int
  name      String
  content   String   @db.Text
  type      String   @default("CUSTOM") // RENT_REVIEW, RENT_RENEWAL, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pm        upward_property_manager @relation(fields: [pmId], references: [id], onDelete: Cascade)

  @@index([pmId])
}

model upward_pm_sent_document {
  id               Int      @id @default(autoincrement())
  uuid             String   @unique @default(uuid())
  pmId             Int
  tenantId         Int?
  unitId           Int?
  subject          String
  content          String   @db.Text
  documentType     String   @default("PDF")
  recipientName    String
  recipientEmail   String
  status           String   @default("SENT") // SENT, DRAFT, FAILED
  includeLetterhead Boolean @default(false)
  isVaultDocument  Boolean  @default(false)   // true = intentionally pushed to tenant vault
  paymentRequestId Int?                        // non-null = came from a payment-request flow
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  pm               upward_property_manager @relation(fields: [pmId], references: [id], onDelete: Cascade)
  tenant           upward_pm_tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  unit             upward_pm_unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([pmId])
  @@index([tenantId])
  @@index([unitId])
  @@index([recipientEmail])
  @@index([isVaultDocument])
}
