model upward_transaction {
  id               Int                     @id @default(autoincrement())
  uuid             String                  @unique @default(uuid())
  userId           Int
  type             String                  @default("RENT")
  status           String                  @default("PENDING")
  amount           Float
  currency         String                  @default("NGN")
  reference        String                  @unique
  narration        String?
  landlordId       String?
  paymentType      String?
  propertyAddress  String?
  lineItems        Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  paymentRequestId Int?
  isManual         Boolean                 @default(false)
  transactionType  String                  @default("PAYMENT")
  proof            upward_payment_proof?
  overpayments     upward_overpayment[]
  refundLogs       upward_refund_log[]
  paymentRequest   upward_payment_request? @relation(fields: [paymentRequestId], references: [id])
  user             upward_user             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Settlement Workflow
  settlementStatus String                  @default("PENDING") // PENDING, VERIFIED, PENDING_REFUND, SETTLED, REFUNDED
  settlementBatchId Int?
  settlementBatch   upward_settlement_batch? @relation(fields: [settlementBatchId], references: [id])

  @@index([userId])
  @@index([reference])
  @@index([paymentRequestId])
}

model upward_payment_request {
  id                Int                         @id @default(autoincrement())
  uuid              String                      @unique @default(uuid())
  userId            Int
  userPropertyId    Int?
  amount            Float
  currency          String                      @default("NGN")
  description       String?
  dueDate           DateTime
  status            String                      @default("PENDING")
  paidAt            DateTime?
  reference         String?                     @unique
  subaccountId      Int?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  allowPartial      Boolean                     @default(false)
  amountPaid        Float                       @default(0)
  minAmount         Float?
  rentStartDate     DateTime?
  rentEndDate       DateTime?
  rentType          String?
  isManual          Boolean                     @default(false)
  reminderFrequency String                      @default("NONE")
  nextReminderAt    DateTime?
  reminderCount     Int                         @default(0)
  scheduledAt       DateTime?
  isRecurring       Boolean                     @default(false)
  recurrenceInterval String?
  overpayments      upward_overpayment[]
  lineItemRecords   upward_payment_line_item[]
  subaccount        upward_paystack_subaccount? @relation(fields: [subaccountId], references: [id])
  user              upward_user                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userProperty      upward_user_property?       @relation(fields: [userPropertyId], references: [id])
  pmPaymentRequests upward_pm_payment_request[]
  rentCycles        upward_rent_cycle[]
  transactions      upward_transaction[]
  paymentProofs     upward_payment_proof[]

  @@index([userId])
  @@index([status])
}

model upward_payment_line_item {
  id               Int                    @id @default(autoincrement())
  uuid             String                 @unique @default(uuid())
  paymentRequestId Int
  totalAmount      Float
  amountPaid       Float                  @default(0)
  status           String                 @default("PENDING")
  sortOrder        Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  name             String
  paymentRequest   upward_payment_request @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)

  @@index([paymentRequestId])
  @@index([status])
}

model upward_rent_cycle {
  id               Int                     @id @default(autoincrement())
  uuid             String                  @unique @default(uuid())
  userId           Int
  userPropertyId   Int?
  paymentRequestId Int?
  source           String                  @default("MANUAL")
  amountOwed       Float
  amountPaid       Float                   @default(0)
  currency         String                  @default("NGN")
  dueDate          DateTime
  paidAt           DateTime?
  status           String                  @default("PENDING")
  description      String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  paymentRequest   upward_payment_request? @relation(fields: [paymentRequestId], references: [id])
  user             upward_user             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userProperty     upward_user_property?   @relation(fields: [userPropertyId], references: [id])

  @@index([userId])
  @@index([userPropertyId])
  @@index([status])
  @@index([dueDate])
}

model upward_overpayment {
  id               Int                     @id @default(autoincrement())
  uuid             String                  @unique @default(uuid())
  userId           Int
  amount           Float
  currency         String                  @default("NGN")
  transactionId    Int?
  paymentRequestId Int?
  status           String                  @default("AVAILABLE")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  paymentRequest   upward_payment_request? @relation(fields: [paymentRequestId], references: [id])
  transaction      upward_transaction?     @relation(fields: [transactionId], references: [id])
  user             upward_user             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model upward_paystack_subaccount {
  id              Int                      @id @default(autoincrement())
  uuid            String                   @unique @default(uuid())
  accountNumber   String
  bankCode        String
  subaccountCode  String                   @unique
  businessName    String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  paymentRequests upward_payment_request[]
  savedLandlords  upward_saved_landlord[]
  properties      upward_user_property[]

  @@unique([accountNumber, bankCode])
  @@index([accountNumber, bankCode])
}

model upward_saved_landlord {
  id            Int                         @id @default(autoincrement())
  uuid          String                      @unique @default(uuid())
  userId        Int
  name          String
  accountName   String
  accountNumber String
  bankName      String
  bankCode      String
  lastAmount    Float?
  lastPaid      DateTime?
  subaccountId  Int?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  subaccount    upward_paystack_subaccount? @relation(fields: [subaccountId], references: [id])

  @@index([userId])
}

model upward_dedicated_virtual_account {
  id                 Int            @id @default(autoincrement())
  uuid               String         @unique @default(uuid())
  accountNumber      String         @unique
  accountName        String
  bankName           String
  bankCode           String
  accountCode        String         @unique // Paystack assigned code
  paystackCustomerId String
  metadata           Json?
  userPropertyId     Int            @unique
  userProperty       upward_user_property @relation(fields: [userPropertyId], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([accountNumber])
  @@index([userPropertyId])
}
model upward_user_bank_details {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  userId        Int      @unique
  accountNumber String
  accountName   String
  bankCode      String
  bankName      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          upward_user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model upward_settlement_batch {
  id              Int                  @id @default(autoincrement())
  uuid            String               @unique @default(uuid())
  landlordId      String?              // Paystack Subaccount Code or Internal ID
  totalAmount     Float
  status          String               @default("PENDING") // PENDING, COMPLETED, FAILED
  transferReference String?            @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  transactions    upward_transaction[]
}

model upward_refund_log {
  id               Int                     @id @default(autoincrement())
  uuid             String                  @unique @default(uuid())
  transactionId    Int
  userId           Int
  pmId             Int?
  amount           Float
  currency         String                  @default("NGN")
  reason           String                  // DUPLICATE_PAYMENT, UNDERPAYMENT_VIOLATION
  status           String                  // FLAGGED, PENDING_DISPATCH, DISPATCHED, PM_ACCEPTED, FAILED
  actionBy         String?                 // SYSTEM, PM_<pmId>, ADMIN_<adminId>
  metadata         Json?
  
  flaggedAt        DateTime                @default(now())
  resolvedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  transaction      upward_transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user             upward_user             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([userId])
}

model upward_fee_override {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  targetType  String   // "USER", "PM", "COMPANY", "PLATFORM"
  targetId    String   // The UUID of the target entity
  fee         Float    // Custom flat fee in NGN
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([targetType, targetId])
  @@index([targetType, targetId])
}

model upward_payment_proof {
  id                Int                   @id @default(autoincrement())
  uuid              String                @unique @default(uuid())
  transactionId     Int?                  @unique
  paymentRequestId  Int?
  userPropertyId    Int?
  amount            Float?
  currency          String                @default("NGN")
  fileUrl           String
  fileName          String?
  uploadedByUserId  Int?
  status            String                @default("PENDING") // PENDING, APPROVED, REJECTED
  remarks           String?
  lineItems         Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  
  transaction       upward_transaction?   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  paymentRequest    upward_payment_request? @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  userProperty      upward_user_property?   @relation(fields: [userPropertyId], references: [id], onDelete: Cascade)

  @@index([paymentRequestId])
  @@index([userPropertyId])
}

