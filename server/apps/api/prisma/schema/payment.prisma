model upward_transaction {
  id                    Int                            @id @default(autoincrement())
  uuid                  String                         @unique @default(uuid())
  userId                Int
  type                  String                         @default("RENT")
  status                String                         @default("PENDING")
  amount                Float
  currency              String                         @default("NGN")
  reference             String                         @unique
  narration             String?
  landlordId            String?
  paymentType           String?
  propertyAddress       String?
  lineItems             Json?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  paymentRequestId      Int?
  transactionType       String                         @default("PAYMENT")
  isManual              Boolean                        @default(false)
  settlementBatchId     Int?
  settlementStatus      String                         @default("PENDING")
  rentStartDate        DateTime?
  rentEndDate          DateTime?
  totalInvoiceAmount   Float?
  historicalPaidToDate Float?
  remainingBalance     Float?
  isPartial            Boolean?
  benefitsSubscriptions upward_benefits_subscription[]
  overpayments          upward_overpayment[]
  proof                 upward_payment_proof?
  refundLogs            upward_refund_log[]
  paymentRequest        upward_payment_request?        @relation(fields: [paymentRequestId], references: [id])
  settlementBatch       upward_settlement_batch?       @relation(fields: [settlementBatchId], references: [id])
  user                  upward_user                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([reference])
  @@index([paymentRequestId])
}

model upward_benefits_subscription {
  id                  Int                   @id @default(autoincrement())
  uuid                String                @unique @default(uuid())
  userId              Int
  userPropertyId      Int?
  status              String                @default("ACTIVE")
  startsAt            DateTime
  endsAt              DateTime
  amountPaid          Float
  currency            String                @default("NGN")
  source              String
  sourceTransactionId Int?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  sourceTransaction   upward_transaction?   @relation(fields: [sourceTransactionId], references: [id])
  user                upward_user           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userProperty        upward_user_property? @relation(fields: [userPropertyId], references: [id])

  @@index([userId])
  @@index([userPropertyId])
  @@index([status])
  @@index([endsAt])
  @@index([userId, userPropertyId, status])
}

model upward_payment_request {
  id                 Int                         @id @default(autoincrement())
  uuid               String                      @unique @default(uuid())
  userId             Int
  userPropertyId     Int?
  amount             Float
  currency           String                      @default("NGN")
  description        String?
  dueDate            DateTime
  status             String                      @default("PENDING")
  paidAt             DateTime?
  reference          String?                     @unique
  subaccountId       Int?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  allowPartial       Boolean                     @default(false)
  amountPaid         Float                       @default(0)
  minAmount          Float?
  isManual           Boolean                     @default(false)
  rentEndDate        DateTime?
  rentStartDate      DateTime?
  rentType           String?
  nextReminderAt     DateTime?
  reminderCount      Int                         @default(0)
  reminderFrequency  String                      @default("NONE")
  isRecurring        Boolean                     @default(false)
  recurrenceInterval String?
  scheduledAt        DateTime?
  overpayments       upward_overpayment[]
  lineItemRecords    upward_payment_line_item[]
  paymentProofs      upward_payment_proof[]
  subaccount         upward_paystack_subaccount? @relation(fields: [subaccountId], references: [id])
  user               upward_user                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userProperty       upward_user_property?       @relation(fields: [userPropertyId], references: [id])
  pmPaymentRequests  upward_pm_payment_request[]
  rentCycles         upward_rent_cycle[]
  transactions       upward_transaction[]

  @@index([userId])
  @@index([status])
}

model upward_payment_line_item {
  id               Int                    @id @default(autoincrement())
  uuid             String                 @unique @default(uuid())
  paymentRequestId Int
  totalAmount      Float
  amountPaid       Float                  @default(0)
  status           String                 @default("PENDING")
  sortOrder        Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  name             String
  paymentRequest   upward_payment_request @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)

  @@index([paymentRequestId])
  @@index([status])
}

model upward_rent_cycle {
  id               Int                     @id @default(autoincrement())
  uuid             String                  @unique @default(uuid())
  userId           Int
  userPropertyId   Int?
  paymentRequestId Int?
  source           String                  @default("MANUAL")
  amountOwed       Float
  amountPaid       Float                   @default(0)
  currency         String                  @default("NGN")
  dueDate          DateTime
  paidAt           DateTime?
  status           String                  @default("PENDING")
  description      String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  paymentRequest   upward_payment_request? @relation(fields: [paymentRequestId], references: [id])
  user             upward_user             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userProperty     upward_user_property?   @relation(fields: [userPropertyId], references: [id])

  @@index([userId])
  @@index([userPropertyId])
  @@index([status])
  @@index([dueDate])
}

model upward_overpayment {
  id               Int                     @id @default(autoincrement())
  uuid             String                  @unique @default(uuid())
  userId           Int
  amount           Float
  currency         String                  @default("NGN")
  transactionId    Int?
  paymentRequestId Int?
  status           String                  @default("AVAILABLE")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  paymentRequest   upward_payment_request? @relation(fields: [paymentRequestId], references: [id])
  transaction      upward_transaction?     @relation(fields: [transactionId], references: [id])
  user             upward_user             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model upward_paystack_subaccount {
  id              Int                      @id @default(autoincrement())
  uuid            String                   @unique @default(uuid())
  accountNumber   String
  bankCode        String
  subaccountCode  String                   @unique
  businessName    String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  paymentRequests upward_payment_request[]
  savedLandlords  upward_saved_landlord[]
  properties      upward_user_property[]

  @@unique([accountNumber, bankCode])
  @@index([accountNumber, bankCode])
}

model upward_saved_landlord {
  id            Int                         @id @default(autoincrement())
  uuid          String                      @unique @default(uuid())
  userId        Int
  name          String
  accountName   String
  accountNumber String
  bankName      String
  bankCode      String
  lastAmount    Float?
  lastPaid      DateTime?
  subaccountId  Int?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  subaccount    upward_paystack_subaccount? @relation(fields: [subaccountId], references: [id])

  @@index([userId])
}

model upward_dedicated_virtual_account {
  id                 Int                  @id @default(autoincrement())
  uuid               String               @unique @default(uuid())
  accountNumber      String               @unique
  accountName        String
  bankName           String
  bankCode           String
  accountCode        String               @unique
  paystackCustomerId String
  metadata           Json?
  userPropertyId     Int                  @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  userProperty       upward_user_property @relation(fields: [userPropertyId], references: [id])

  @@index([accountNumber])
  @@index([userPropertyId])
}

model upward_user_bank_details {
  id            Int         @id @default(autoincrement())
  uuid          String      @unique @default(uuid())
  userId        Int         @unique
  accountNumber String
  accountName   String
  bankCode      String
  bankName      String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          upward_user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model upward_settlement_batch {
  id                Int                  @id @default(autoincrement())
  uuid              String               @unique @default(uuid())
  landlordId        String?
  totalAmount       Float
  status            String               @default("PENDING")
  transferReference String?              @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  transactions      upward_transaction[]
}

model upward_refund_log {
  id            Int                @id @default(autoincrement())
  uuid          String             @unique @default(uuid())
  transactionId Int
  userId        Int
  pmId          Int?
  amount        Float
  currency      String             @default("NGN")
  reason        String
  status        String
  actionBy      String?
  metadata      Json?
  flaggedAt     DateTime           @default(now())
  resolvedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  transaction   upward_transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user          upward_user        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([userId])
}

model upward_wallet {
  id           Int                         @id @default(autoincrement())
  uuid         String                      @unique @default(uuid())
  userId       Int                         @unique
  balance      Float                       @default(0)
  currency     String                      @default("NGN")
  isActive     Boolean                     @default(true)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  user         upward_user                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions upward_wallet_transaction[]

  @@index([userId])
}

model upward_wallet_transaction {
  id        Int           @id @default(autoincrement())
  uuid      String        @unique @default(uuid())
  walletId  Int
  userId    Int
  type      String
  status    String        @default("SUCCESS")
  amount    Float
  reference String?       @unique
  narration String?
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      upward_user   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet    upward_wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([userId])
  @@index([type])
}

model upward_savings_goal {
  id                Int         @id @default(autoincrement())
  uuid              String      @unique @default(uuid())
  userId            Int
  name              String
  category          String
  targetAmount      Float
  currentAmount     Float       @default(0)
  startDate         DateTime?
  endDate           DateTime?
  reminderEnabled   Boolean     @default(true)
  reminderFrequency String?
  reminderDay       Int?
  autoSaveEnabled   Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              upward_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

model upward_savings_config {
  id                Int      @id @default(autoincrement())
  key               String   @unique
  dailyInterestRate Float    @default(0)
  updatedByAdminId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model upward_fee_override {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  targetType String
  targetId   String
  fee        Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([targetType, targetId])
  @@index([targetType, targetId])
}

model upward_payment_proof {
  id               Int                     @id @default(autoincrement())
  uuid             String                  @unique @default(uuid())
  transactionId    Int?                    @unique
  paymentRequestId Int?
  fileUrl          String?
  fileName         String?
  uploadedByUserId Int?
  status           String                  @default("PENDING")
  remarks          String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  amount           Float?
  currency         String                  @default("NGN")
  userPropertyId   Int?
  lineItems        Json?
  paymentDate      DateTime?
  referenceNumber  String?
  senderName       String?
  paymentRequest   upward_payment_request? @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  transaction      upward_transaction?     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  userProperty     upward_user_property?   @relation(fields: [userPropertyId], references: [id], onDelete: Cascade)

  @@index([paymentRequestId])
  @@index([userPropertyId])
}
