model upward_user {
  id                    Int                              @id @default(autoincrement())
  uuid                  String                           @unique @default(uuid())
  passwordHash          String
  email                 String
  firstName             String
  lastName              String
  phone                 String?
  emailHash             String                           @unique
  firstNameHash         String
  lastNameHash          String
  phoneHash             String?
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  gender                String?
  dateOfBirth           String?
  isFromWaitlist        Boolean                          @default(false)
  isFromInvite          Boolean                          @default(false)
  invitedAt             DateTime?
  joinedAt              DateTime?
  profileSlug           String?                          @unique
  bio                   String?
  profilePic            String?
  resetPasswordOTP      String?
  resetPasswordExpires  DateTime?
  campaignWeekSent      Int                              @default(0)
  unsubscribed          Boolean                          @default(false)
  unsubscribedAt        DateTime?
  isIdentityVerified    Boolean                          @default(false)
  authProvider          String                           @default("email")
  providerId            String?                          @unique
  isInternal            Boolean                          @default(false)
  isBlocked             Boolean                          @default(false)
  isManuallyBlocked     Boolean                          @default(false)
  disabledAt            DateTime?
  savingsWalletEnabled  Boolean                          @default(false)
  termsAcceptedAt       DateTime?
  termsVersion          String?                          @default("2026-08-24")
  authSessions          upward_auth_session[]
  benefitsSubscriptions upward_benefits_subscription[]
  communicationLogs     upward_communication_log[]
  companyUsers          upward_company_user[]
  credibilityRequests   upward_credibility_request[]
  deviceTokens          upward_device_token[]
  emailSequenceLogs     upward_email_sequence_log[]
  feedback              upward_feedback[]
  notifications         upward_notification[]
  overpayments          upward_overpayment[]
  paymentRequests       upward_payment_request[]
  refundLogs            upward_refund_log[]
  rentCycles            upward_rent_cycle[]
  savingsGoals          upward_savings_goal[]
  supportTickets        upward_support_ticket[]
  transactions          upward_transaction[]
  announcementStates    upward_user_announcement_state[]
  bankDetails           upward_user_bank_details?
  contracts             upward_user_contract[]
  properties            upward_user_property[]
  wallet                upward_wallet?
  walletTransactions    upward_wallet_transaction[]
  whatsappSequenceLogs  upward_whatsapp_sequence_log[]

  @@index([email])
  @@index([createdAt])
}

model upward_auth_session {
  id               String      @id @default(uuid())
  userId           Int
  refreshTokenHash String      @unique
  userAgent        String?
  ipAddress        String?
  deviceId         String?
  isRevoked        Boolean     @default(false)
  expiresAt        DateTime
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  city             String?
  country          String?
  user             upward_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
}

model upward_verification_token {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  token      String?  @unique
  otp        String?
  context    String
  identifier String
  metadata   Json?
  resends    Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([token])
  @@index([identifier, context])
}

model upward_device_token {
  id        Int         @id @default(autoincrement())
  userId    Int
  token     String
  platform  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      upward_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

model upward_admin {
  id                   String                      @id @default(uuid())
  email                String                      @unique
  passwordHash         String
  role                 String                      @default("ADMIN")
  mustChangePassword   Boolean                     @default(true)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  phone                String?                     @unique
  receivesSystemAlerts Boolean                     @default(false)
  logs                 upward_admin_log[]
  bulkImportJobs       upward_pm_bulk_import_job[]
  subscriptionLogs     upward_subscription_log[]

  @@index([email])
}

model upward_admin_log {
  id        String       @id @default(uuid())
  adminId   String
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime     @default(now())
  admin     upward_admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model upward_email_sequence_log {
  id                Int                        @id @default(autoincrement())
  uuid              String                     @unique @default(uuid())
  userId            Int
  email             String
  stage             String
  status            String                     @default("PENDING")
  scheduledFor      DateTime
  sentAt            DateTime?
  errorReason       String?
  templateName      String
  templateData      Json?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  isOpened          Boolean                    @default(false)
  openCount         Int                        @default(0)
  openedAt          DateTime?
  userAgent         String?
  communicationLogs upward_communication_log[]
  user              upward_user                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, scheduledFor])
}
