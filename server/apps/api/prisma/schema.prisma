generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model upward_waitlist {
  id                       String              @id @default(uuid())
  email                    String              @unique
  firstName                String?
  lastName                 String?
  phone                    String?
  role                     String?
  benefits                 String[]
  acceptTerms              Boolean             @default(false)
  wantsAmbassador          Boolean             @default(false)
  country                  String?
  city                     String?
  selectedSession          String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  confirmationSent         Boolean             @default(false)
  abVariant                String?
  confirmationEmailError   String?
  confirmationEmailRetries Int                 @default(0)
  confirmationEmailStatus  String?
  campaignWeekSent         Int                 @default(0)
  unsubscribed             Boolean             @default(false)
  unsubscribedAt           DateTime?
  attendances              upward_attendance[]
  emailLogs                upward_email_log[]

  @@index([email])
  @@index([createdAt])
  @@index([confirmationEmailStatus])
}

model upward_session {
  id             String              @id @default(uuid())
  name           String
  googleMeetLink String
  startTime      DateTime
  endTime        DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  attendances    upward_attendance[]
  emailLogs      upward_email_log[]

  @@index([startTime])
}

model upward_attendance {
  id        String          @id @default(uuid())
  sessionId String
  userId    String
  attended  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  session   upward_session  @relation(fields: [sessionId], references: [id])
  user      upward_waitlist @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

model upward_email_log {
  id        String          @id @default(uuid())
  userId    String
  sessionId String?
  subject   String
  sentAt    DateTime?
  status    String
  createdAt DateTime        @default(now())
  email     String?
  lastError String?
  mailgunId String?
  type      String          @default("GENERIC")
  updatedAt DateTime        @updatedAt
  retries   Int             @default(0)
  body      String?
  session   upward_session? @relation(fields: [sessionId], references: [id])
  user      upward_waitlist @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@index([type])
}

model upward_admin {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String
  role               String             @default("ADMIN")
  mustChangePassword Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  logs               upward_admin_log[]

  @@index([email])
}

model upward_admin_log {
  id        String       @id @default(uuid())
  adminId   String
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime     @default(now())
  admin     upward_admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model upward_interaction {
  id        String   @id @default(uuid())
  visitorId String
  type      String
  target    String
  abVariant String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  metadata  String?

  @@index([visitorId])
  @@index([type])
  @@index([createdAt])
}

model upward_error_log {
  id        String   @id @default(uuid())
  message   String
  stack     String?
  context   String?
  severity  String   @default("ERROR")
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([severity])
  @@index([resolved])
}

model upward_email_campaign {
  id          String   @id @default(uuid())
  weekNumber  Int      @unique
  subject     String
  htmlContent String
  textContent String?
  label       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([weekNumber])
  @@index([isActive])
}

model upward_system_email {
  id          String   @id @default(uuid())
  slug        String   @unique
  subject     String
  htmlContent String
  textContent String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model upward_fairness_story {
  id         String   @id @default(uuid())
  name       String?
  categories String[]
  story      String
  audioUrl   String?
  fileUrls   String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
}

model upward_user {
  id                   Int                              @id @default(autoincrement())
  uuid                 String                           @unique @default(uuid())
  passwordHash         String
  email                String
  firstName            String
  lastName             String
  phone                String?
  emailHash            String                           @unique
  firstNameHash        String
  lastNameHash         String
  phoneHash            String?
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  gender               String?
  dateOfBirth          String?
  isFromWaitlist       Boolean                          @default(false)
  isFromInvite         Boolean                          @default(false)
  profileSlug          String?                          @unique
  bio                  String?
  profilePic           String?
  resetPasswordOTP     String?
  resetPasswordExpires DateTime?
  authSessions         upward_auth_session[]
  companyUsers         upward_company_user[]
  credibilityRequests  upward_credibility_request[]
  deviceTokens         upward_device_token[]
  notifications        upward_notification[]
  overpayments         upward_overpayment[]
  paymentRequests      upward_payment_request[]
  rentCycles           upward_rent_cycle[]
  supportTickets       upward_support_ticket[]
  announcementStates   upward_user_announcement_state[]
  contracts            upward_user_contract[]
  properties           upward_user_property[]

  @@index([email])
  @@index([createdAt])
}

model upward_device_token {
  id        Int         @id @default(autoincrement())
  userId    Int
  token     String
  platform  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      upward_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

model upward_support_ticket {
  id         Int         @id @default(autoincrement())
  uuid       String      @unique @default(uuid())
  userId     Int
  message    String
  status     String      @default("OPEN")
  resolvedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       upward_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model upward_saved_landlord {
  id            Int                         @id @default(autoincrement())
  uuid          String                      @unique @default(uuid())
  userId        Int
  name          String
  accountName   String
  accountNumber String
  bankName      String
  bankCode      String
  lastAmount    Float?
  lastPaid      DateTime?
  subaccountId  Int?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  subaccount    upward_paystack_subaccount? @relation(fields: [subaccountId], references: [id])

  @@index([userId])
}

model upward_transaction {
  id               Int                     @id @default(autoincrement())
  uuid             String                  @unique @default(uuid())
  userId           Int
  type             String                  @default("RENT")
  status           String                  @default("PENDING")
  amount           Float
  currency         String                  @default("NGN")
  reference        String                  @unique
  narration        String?
  landlordId       String?
  paymentType      String?
  propertyAddress  String?
  lineItems        Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  paymentRequestId Int?
  isManual         Boolean                 @default(false)
  transactionType  String                  @default("PAYMENT")
  overpayments     upward_overpayment[]
  paymentRequest   upward_payment_request? @relation(fields: [paymentRequestId], references: [id])

  @@index([userId])
  @@index([reference])
  @@index([paymentRequestId])
}

model upward_announcement {
  id        Int                              @id @default(autoincrement())
  uuid      String                           @unique @default(uuid())
  title     String
  message   String
  iconType  String                           @default("sparkles")
  isActive  Boolean                          @default(true)
  createdAt DateTime                         @default(now())
  updatedAt DateTime                         @updatedAt
  url       String?
  states    upward_user_announcement_state[]

  @@index([isActive])
  @@index([createdAt])
}

model upward_user_announcement_state {
  id               Int                 @id @default(autoincrement())
  uuid             String              @unique @default(uuid())
  userId           Int
  announcementId   Int
  seenPopup        Boolean             @default(false)
  interactedPopup  Boolean             @default(false)
  seenBanner       Boolean             @default(false)
  interactedBanner Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  announcement     upward_announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user             upward_user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([userId])
}

model upward_notification {
  id        Int         @id @default(autoincrement())
  uuid      String      @unique @default(uuid())
  userId    Int
  title     String
  message   String
  type      String      @default("SYSTEM")
  url       String?
  isRead    Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      upward_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model upward_payment_request {
  id              Int                         @id @default(autoincrement())
  uuid            String                      @unique @default(uuid())
  userId          Int
  userPropertyId  Int?
  amount          Float
  currency        String                      @default("NGN")
  description     String?
  dueDate         DateTime
  status          String                      @default("PENDING")
  paidAt          DateTime?
  reference       String?                     @unique
  subaccountId    Int?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  allowPartial    Boolean                     @default(false)
  amountPaid      Float                       @default(0)
  minAmount       Float?
  isManual        Boolean                     @default(false)
  overpayments    upward_overpayment[]
  lineItemRecords upward_payment_line_item[]
  subaccount      upward_paystack_subaccount? @relation(fields: [subaccountId], references: [id])
  user            upward_user                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userProperty    upward_user_property?       @relation(fields: [userPropertyId], references: [id])
  rentCycles      upward_rent_cycle[]
  transactions    upward_transaction[]
  pmPaymentRequests upward_pm_payment_request[]

  @@index([userId])
  @@index([status])
}

model upward_payment_line_item {
  id               Int                    @id @default(autoincrement())
  uuid             String                 @unique @default(uuid())
  paymentRequestId Int
  totalAmount      Float
  amountPaid       Float                  @default(0)
  status           String                 @default("PENDING")
  sortOrder        Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  name             String
  paymentRequest   upward_payment_request @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)

  @@index([paymentRequestId])
  @@index([status])
}

model upward_company {
  id           Int                    @id @default(autoincrement())
  uuid         String                 @unique @default(uuid())
  name         String
  address      String?
  email        String?
  phone        String?
  emailHash    String?                @unique
  phoneHash    String?
  nameHash     String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  platformId   Int?
  platform     upward_platform?       @relation(fields: [platformId], references: [id], onDelete: Cascade)
  companyUsers upward_company_user[]
  managers     upward_manager[]
  properties   upward_user_property[]
}

model upward_platform {
  id          Int                  @id @default(autoincrement())
  uuid        String               @unique @default(uuid())
  apiKey      String               @unique
  webhookUrl  String
  name        String
  address     String?
  email       String?
  emailHash   String?              @unique
  nameHash    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  companies   upward_company[]
  webhookLogs upward_webhook_log[]
}

model upward_company_user {
  id         Int            @id @default(autoincrement())
  uuid       String         @unique @default(uuid())
  companyId  Int
  userId     Int
  invitedAt  DateTime       @default(now())
  acceptedAt DateTime?
  company    upward_company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       upward_user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
}

model upward_manager {
  id            Int                    @id @default(autoincrement())
  uuid          String                 @unique @default(uuid())
  companyId     Int
  /// @encrypted
  firstName     String?
  /// @encrypted
  lastName      String?
  /// @encrypted
  phone         String?
  /// @encrypted
  email         String?
  emailHash     String?                @unique
  phoneHash     String?
  firstNameHash String?
  lastNameHash  String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  company       upward_company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  properties    upward_user_property[]
}

model upward_location {
  id         Int                    @id @default(autoincrement())
  uuid       String                 @unique @default(uuid())
  country    String
  state      String
  area       String
  subarea    String?
  address    String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  properties upward_user_property[]
}

model upward_user_property {
  id              Int                          @id @default(autoincrement())
  uuid            String                       @unique @default(uuid())
  userId          Int
  companyId       Int?
  managerId       Int?
  locationId      Int?
  rentAmount      Float                        @default(0)
  currency        String                       @default("NGN")
  rentStartDate   DateTime?
  rentEndDate     DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  isVerified      Boolean                      @default(false)
  amountPaid      Float                        @default(0)
  amountRemaining Float                        @default(0)
  isPastTenancy   Boolean                      @default(false)
  paymentRequests upward_payment_request[]
  infractions     upward_property_infraction[]
  inspections     upward_property_inspection[]
  rentCycles      upward_rent_cycle[]
  contracts       upward_user_contract[]
  company         upward_company?              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location        upward_location?             @relation(fields: [locationId], references: [id])
  manager         upward_manager?              @relation(fields: [managerId], references: [id])
  user            upward_user                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  pmId            Int?
  pm              upward_property_manager?     @relation(fields: [pmId], references: [id])
  pmUnitId        Int?
  pmUnit          upward_pm_unit?              @relation(fields: [pmUnitId], references: [id])
}

model upward_property_inspection {
  id             Int                  @id @default(autoincrement())
  uuid           String               @unique @default(uuid())
  userPropertyId Int
  inspectorName  String?
  score          Float?
  reportUrl      String?
  source         String               @default("UPWARD")
  notes          String?
  createdAt      DateTime             @default(now())
  userProperty   upward_user_property @relation(fields: [userPropertyId], references: [id], onDelete: Cascade)

  @@index([userPropertyId])
}

model upward_property_infraction {
  id               Int                  @id @default(autoincrement())
  uuid             String               @unique @default(uuid())
  userPropertyId   Int
  description      String
  amountOwed       Float                @default(0)
  isResolved       Boolean              @default(false)
  reportedToBureau Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  userProperty     upward_user_property @relation(fields: [userPropertyId], references: [id], onDelete: Cascade)

  @@index([userPropertyId])
}

model upward_paystack_subaccount {
  id              Int                      @id @default(autoincrement())
  uuid            String                   @unique @default(uuid())
  accountNumber   String
  bankCode        String
  subaccountCode  String                   @unique
  businessName    String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  paymentRequests upward_payment_request[]
  savedLandlords  upward_saved_landlord[]

  @@unique([accountNumber, bankCode])
  @@index([accountNumber, bankCode])
}

model upward_webhook_log {
  id           String          @id @default(uuid())
  platformId   Int
  event        String
  url          String
  payload      Json
  status       String
  responseCode Int?
  errorMessage String?
  retries      Int             @default(0)
  lastTriedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  platform     upward_platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId])
  @@index([status])
  @@index([createdAt])
}

model upward_rent_cycle {
  id               Int                     @id @default(autoincrement())
  uuid             String                  @unique @default(uuid())
  userId           Int
  userPropertyId   Int?
  paymentRequestId Int?
  source           String                  @default("MANUAL")
  amountOwed       Float
  amountPaid       Float                   @default(0)
  currency         String                  @default("NGN")
  dueDate          DateTime
  paidAt           DateTime?
  status           String                  @default("PENDING")
  description      String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  paymentRequest   upward_payment_request? @relation(fields: [paymentRequestId], references: [id])
  user             upward_user             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userProperty     upward_user_property?   @relation(fields: [userPropertyId], references: [id])

  @@index([userId])
  @@index([userPropertyId])
  @@index([status])
  @@index([dueDate])
}

model upward_user_contract {
  id             Int                   @id @default(autoincrement())
  uuid           String                @unique @default(uuid())
  userId         Int
  userPropertyId Int?
  fileName       String
  fileUrl        String
  fileType       String
  fileSize       Int
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  user           upward_user           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userProperty   upward_user_property? @relation(fields: [userPropertyId], references: [id])

  @@index([userId])
  @@index([userPropertyId])
}

model upward_auth_session {
  id               String      @id @default(uuid())
  userId           Int
  refreshTokenHash String      @unique
  userAgent        String?
  ipAddress        String?
  deviceId         String?
  isRevoked        Boolean     @default(false)
  expiresAt        DateTime
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             upward_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
}

model upward_overpayment {
  id               Int                     @id @default(autoincrement())
  uuid             String                  @unique @default(uuid())
  userId           Int
  amount           Float
  currency         String                  @default("NGN")
  transactionId    Int?
  paymentRequestId Int?
  status           String                  @default("AVAILABLE")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  paymentRequest   upward_payment_request? @relation(fields: [paymentRequestId], references: [id])
  transaction      upward_transaction?     @relation(fields: [transactionId], references: [id])
  user             upward_user             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model upward_credibility_request {
  id           Int         @id @default(autoincrement())
  uuid         String      @unique @default(uuid())
  userId       Int
  propertyUuid String
  /// @encrypted
  companyName  String?
  /// @encrypted
  managerName  String?
  /// @encrypted
  email        String?
  /// @encrypted
  phone        String?
  status       String      @default("PENDING")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         upward_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyUuid])
  @@index([status])
}

model upward_verification_token {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  token      String?  @unique
  otp        String?
  context    String
  identifier String
  metadata   Json?
  resends    Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([token])
  @@index([identifier, context])
}

model upward_whatsapp_sessions {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique(map: "upward_whatsapp_sessions_uuid_unique") @db.Uuid
  phone         String?   @db.VarChar(255)
  phoneHash     String?   @db.VarChar(255)
  state         String    @default("NEW") @db.VarChar(255)
  sessionData   Json?
  lastMessageAt DateTime? @db.Timestamp(0)
  expiresAt     DateTime? @db.Timestamp(0)
  createdAt     DateTime  @default(now()) @db.Timestamp(0)
  updatedAt     DateTime  @default(now()) @db.Timestamp(0)

  @@index([expiresAt], map: "upward_whatsapp_sessions_expiresat_index")
  @@index([lastMessageAt], map: "upward_whatsapp_sessions_lastmessageat_index")
  @@index([phone], map: "upward_whatsapp_sessions_phone_index")
  @@index([phoneHash], map: "upward_whatsapp_sessions_phonehash_index")
}

model upward_whatsapp_transaction_pins {
  id             Int      @id @default(autoincrement())
  uuid           String   @unique(map: "upward_whatsapp_transaction_pins_uuid_unique") @db.Uuid
  upwardUserUuid String   @unique(map: "upward_whatsapp_transaction_pins_upwarduseruuid_unique") @db.Uuid
  pinHash        String   @db.VarChar(255)
  createdAt      DateTime @default(now()) @db.Timestamp(0)
  updatedAt      DateTime @default(now()) @db.Timestamp(0)

  @@index([upwardUserUuid], map: "upward_whatsapp_transaction_pins_upwarduseruuid_index")
}
model upward_property_manager {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  email        String   @unique
  emailHash    String   @unique
  passwordHash String
  firstName    String
  firstNameHash String?
  lastName     String
  lastNameHash  String?
  businessName String?
  phone        String?
  phoneHash    String?
  profilePic   String?
  bankName     String?
  bankCode     String?
  accountNumber String?
  accountName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  authSessions upward_pm_auth_session[]
  properties   upward_pm_property[]
  tenants      upward_pm_tenant[]
  userProperties upward_user_property[]
  paymentRequests upward_pm_payment_request[]
  bulkInvites     upward_pm_bulk_invite[]
  
  @@index([email])
}

model upward_pm_auth_session {
  id               String   @id @default(uuid())
  pmId             Int
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  deviceId         String?
  isRevoked        Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pm upward_property_manager @relation(fields: [pmId], references: [id], onDelete: Cascade)

  @@index([pmId])
}

model upward_pm_property {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  pmId         Int
  name         String
  address      String?
  totalUnits   Int      @default(0)
  propertyType String   @default("Residential")
  imageUrl     String?
  country      String   @default("Nigeria")
  state        String?
  area         String?
  
  landlordNameEncrypted   String?
  landlordNameSearch      String?
  landlordEmailEncrypted  String?
  landlordEmailHash       String?
  landlordPhoneEncrypted  String?
  landlordPhoneHash       String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pm    upward_property_manager @relation(fields: [pmId], references: [id], onDelete: Cascade)
  units upward_pm_unit[]

  @@index([pmId])
}

model upward_pm_unit {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  propertyId   Int
  unitName     String
  
  rentAmount      Float    @default(0)
  rentStartDate   DateTime?
  rentDueDate     DateTime? // Specific due date or next due date
  rentType        String   @default("Monthly") // Monthly, Quarterly, Bi-Annually, Annually
  currency        String   @default("NGN")
  managementFee   Float    @default(0)
  notes           String?  @db.Text
  status          String   @default("VACANT") // OCCUPIED, VACANT, MAINTENANCE
  
  tenantId        Int?
  tenant          upward_pm_tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  
  isSynced        Boolean  @default(false)
  userPropertyUuid String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property upward_pm_property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rentPayments upward_pm_rent_payment[]
  userProperties upward_user_property[]
  paymentRequests upward_pm_payment_request[]

  @@index([propertyId])
  @@index([status])
  @@index([tenantId])
}

model upward_pm_tenant {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  pmId      Int
  
  firstNameEncrypted String?  /// @encrypted
  firstNameSearch    String?
  lastNameEncrypted  String?  /// @encrypted
  lastNameSearch     String?
  emailEncrypted     String?  /// @encrypted
  emailHash          String?
  phoneEncrypted     String?  /// @encrypted
  phoneHash          String?
  
  inviteStatus       String   @default("PENDING") // PENDING, SENT, ON_UPWARD, ACCEPTED
  inviteSentAt       DateTime?
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  pm                 upward_property_manager @relation(fields: [pmId], references: [id], onDelete: Cascade)
  units              upward_pm_unit[]
  paymentRequests    upward_pm_payment_request[]

  @@index([pmId])
  @@index([emailHash])
}

model upward_pm_rent_payment {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  unitId       Int
  amount       Float
  paymentDate  DateTime
  periodStart  DateTime?
  periodEnd    DateTime?
  method       String   @default("Bank Transfer") // Bank Transfer, Cash, Card, Other
  reference    String?
  status       String   @default("SUCCESS") // SUCCESS, PENDING, FAILED
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  unit upward_pm_unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([paymentDate])
}

model upward_pm_payment_request {
  id               Int      @id @default(autoincrement())
  uuid             String   @unique @default(uuid())
  pmId             Int
  unitId           Int
  tenantId         Int?
  paymentRequestId Int?     // Links to the core upward_payment_request
  
  amount           Float
  currency         String   @default("NGN")
  description      String?
  dueDate          DateTime
  status           String   @default("PENDING") // PENDING, PARTIAL, PAID
  amountPaid       Float    @default(0)
  allowPartial     Boolean  @default(false)
  minAmount        Float?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pm             upward_property_manager @relation(fields: [pmId], references: [id], onDelete: Cascade)
  unit           upward_pm_unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenant         upward_pm_tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  paymentRequest upward_payment_request? @relation(fields: [paymentRequestId], references: [id])

  @@index([pmId])
  @@index([unitId])
  @@index([status])
}

model upward_pm_bulk_invite {
  id           String   @id @default(uuid())
  pmId         Int
  status       String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  totalTenants Int      @default(0)
  sentCount    Int      @default(0)
  failedCount  Int      @default(0)
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pm           upward_property_manager @relation(fields: [pmId], references: [id], onDelete: Cascade)
  items        upward_pm_bulk_invite_item[]

  @@index([pmId])
  @@index([status])
}

model upward_pm_bulk_invite_item {
  id           String   @id @default(uuid())
  bulkInviteId String
  tenantUuid   String
  status       String   @default("PENDING") // PENDING, SENT, FAILED
  error        String?
  retries      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bulkInvite   upward_pm_bulk_invite @relation(fields: [bulkInviteId], references: [id], onDelete: Cascade)

  @@index([bulkInviteId])
  @@index([status])
}
