generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model upward_waitlist {
  id              String   @id @default(uuid())
  email           String   @unique
  firstName       String?
  lastName        String?
  phone           String?
  role            String?
  benefits        String[]
  acceptTerms     Boolean  @default(false)
  wantsAmbassador Boolean  @default(false)
  country         String?
  city            String?
  selectedSession String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  campaignWeekSent      Int      @default(0)  // How many Tuesday drip emails have been sent to this user. 0 = never sent. Next send = this+1.
  confirmationSent Boolean  @default(false)
  confirmationEmailStatus String?  // PENDING, SENT, FAILED
  confirmationEmailError  String?
  confirmationEmailRetries Int     @default(0)
  abVariant        String?
  unsubscribed     Boolean  @default(false)
  unsubscribedAt   DateTime?

  attendances     upward_attendance[]
  emailLogs       upward_email_log[]

  @@index([email])
  @@index([createdAt])
  @@index([confirmationEmailStatus])
}

model upward_session {
  id             String   @id @default(uuid())
  name           String
  googleMeetLink String
  startTime      DateTime
  endTime        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attendances    upward_attendance[]
  emailLogs      upward_email_log[]

  @@index([startTime])
}

model upward_attendance {
  id        String   @id @default(uuid())
  sessionId String
  userId    String
  attended  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      upward_waitlist @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   upward_session  @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, userId])
}

model upward_email_log {
  id        String   @id @default(uuid())
  userId    String
  email     String?
  sessionId String?
  subject   String
  type      String   @default("GENERIC") // CONFIRMATION, BULK, SESSION_INVITE, etc.
  status    String   // SENT, FAILED
  body      String?  @db.Text
  mailgunId String?
  lastError String?
  retries   Int      @default(0)
  sentAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      upward_waitlist @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   upward_session? @relation(fields: [sessionId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@index([type])
}
model upward_admin {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String
  role               String   @default("ADMIN") // ADMIN, SUPERADMIN
  mustChangePassword Boolean  @default(true) 
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([email])
  logs               upward_admin_log[]
}

model upward_admin_log {
  id        String   @id @default(uuid())
  adminId   String
  action    String   // LOGIN, LOGOUT, EXPORT_CSV, SEND_EMAIL, ADD_ADMIN, DELETE_ADMIN, DEMOTE_ADMIN, DELETE_USER, etc.
  details   String?  // Summary or JSON string: "Deleted 3 users", "Subject: Welcome Email"
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  admin     upward_admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model upward_interaction {
  id               String   @id @default(uuid())
  visitorId        String   // Anonymous ID from localStorage
  type             String   // CLICK, VIEW, SCROLL
  target           String   // e.g. "HERO_CTA", "BENEFITS_SECTION"
  abVariant        String   // A or B
  ipAddress        String?
  userAgent        String?
  metadata         String?
  createdAt        DateTime @default(now())

  @@index([visitorId])
  @@index([type])
  @@index([createdAt])
}

model upward_error_log {
  id        String   @id @default(uuid())
  message   String
  stack     String?
  context   String?  // JSON string of request context (URL, Body, Params, etc.)
  severity  String   @default("ERROR") // ERROR, WARNING, INFO
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([severity])
  @@index([resolved])
}

model upward_email_campaign {
  id          String   @id @default(uuid())
  weekNumber  Int      @unique  // 1, 2, 3, ... — which week in the drip sequence
  subject     String
  htmlContent String   @db.Text
  textContent String?  @db.Text
  label       String?  // e.g. "Welcome to Upward", "Week 2: Housing Tips"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([weekNumber])
  @@index([isActive])
}

model upward_system_email {
  id          String   @id @default(uuid())
  slug        String   @unique // SIGNUP_CONFIRMATION, etc.
  subject     String
  htmlContent String   @db.Text
  textContent String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model upward_fairness_story {
  id              String   @id @default(uuid())
  name            String?
  categories      String[]
  story           String   @db.Text
  audioUrl        String?
  fileUrls        String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
}

model upward_tenant {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invitedByCompanyId     String?
  invitedByCompanyName   String?
  invitedByCompanyLogo   String?
  rentAnniversary        DateTime?
  address                String?
  occupation             String?
  gender                 String?
  dateOfBirth            String?
  isConvertedFromWaitlist Boolean @default(false)
  isGuest                Boolean @default(false)
  hasDismissedAppBanner  Boolean @default(false)
  savingsBalance         Float   @default(0)
  savingsGoal            Float   @default(0)
  creditScore            Int      @default(300)
  profileSlug            String?  @unique
  bio                    String?  @db.Text
  isProfileComplete      Boolean  @default(false)
  reliabilityRank        String   @default("A")
  onTimePercentage       Float    @default(100)
  earlyPaymentStreak     Int      @default(0)
  savingsImpact          Float    @default(0)

  announcementStates upward_tenant_announcement_state[]
  notifications      upward_notification[]

  wallet             upward_wallet?
  savingsGoals       upward_savings_goal[]

  @@index([email])
  @@index([createdAt])
}

model upward_saved_landlord {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  accountName   String
  accountNumber String
  bankName      String
  bankCode      String
  lastAmount    Float?
  lastPaid      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

model upward_wallet {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  balance       Float    @default(0)
  accountNumber String?
  accountName   String?
  bankName      String?
  bankCode      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant       upward_tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions upward_transaction[]
}

model upward_savings_goal {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  targetAmount  Float
  currentAmount Float    @default(0)
  startDate     DateTime @default(now())
  endDate       DateTime?
  status        String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  
  reminderEnabled   Boolean  @default(false)
  reminderFrequency String?  // DAILY, WEEKLY, BI_WEEKLY, MONTHLY, TWO_DAYS
  reminderDay       Int?     // Day of month (1-31) or weekday (0-6)
  autoSaveEnabled   Boolean  @default(false)
  autoSaveAmount    Float?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        upward_tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions  upward_transaction[]
}

model upward_transaction {
  id            String   @id @default(uuid())
  tenantId      String
  type          String   @default("RENT") // RENT, SAVINGS, WALLET_DEPOSIT, WALLET_WITHDRAWAL, GOAL_ALLOCATION
  status        String   @default("PENDING") // PENDING, SUCCESS, FAILED
  amount        Float
  reference     String   @unique
  narration     String?
  landlordId    String?
  lineItems     Json?
  walletId      String?
  goalId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wallet        upward_wallet? @relation(fields: [walletId], references: [id])
  goal          upward_savings_goal? @relation(fields: [goalId], references: [id])

  @@index([tenantId])
  @@index([reference])
  @@index([walletId])
  @@index([goalId])
}

model upward_announcement {
  id        String   @id @default(uuid())
  title     String
  message   String   @db.Text
  iconType  String   @default("sparkles") // sparkles, clock, target, etc.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states    upward_tenant_announcement_state[]

  @@index([isActive])
  @@index([createdAt])
}

model upward_tenant_announcement_state {
  id               String   @id @default(uuid())
  tenantId         String
  announcementId   String
  seenPopup        Boolean  @default(false)
  interactedPopup  Boolean  @default(false)
  seenBanner       Boolean  @default(false)
  interactedBanner Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  announcement     upward_announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  tenant           upward_tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, announcementId])
  @@index([tenantId])
}

model upward_notification {
  id        String   @id @default(uuid())
  tenantId  String
  title     String
  message   String   @db.Text
  type      String   @default("SYSTEM") // SYSTEM, SUPPORT, PAYMENT
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    upward_tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([isRead])
  @@index([createdAt])
}

