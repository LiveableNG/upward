generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model upward_waitlist {
  id                       String    @id @default(uuid())
  email                    String    @unique
  firstName                String?
  lastName                 String?
  phone                    String?
  role                     String?
  benefits                 String[]
  acceptTerms              Boolean   @default(false)
  wantsAmbassador          Boolean   @default(false)
  country                  String?
  city                     String?
  selectedSession          String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  campaignWeekSent         Int       @default(0) // How many Tuesday drip emails have been sent to this user. 0 = never sent. Next send = this+1.
  confirmationSent         Boolean   @default(false)
  confirmationEmailStatus  String? // PENDING, SENT, FAILED
  confirmationEmailError   String?
  confirmationEmailRetries Int       @default(0)
  abVariant                String?
  unsubscribed             Boolean   @default(false)
  unsubscribedAt           DateTime?

  attendances upward_attendance[]
  emailLogs   upward_email_log[]

  @@index([email])
  @@index([createdAt])
  @@index([confirmationEmailStatus])
}

model upward_session {
  id             String   @id @default(uuid())
  name           String
  googleMeetLink String
  startTime      DateTime
  endTime        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attendances upward_attendance[]
  emailLogs   upward_email_log[]

  @@index([startTime])
}

model upward_attendance {
  id        String   @id @default(uuid())
  sessionId String
  userId    String
  attended  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    upward_waitlist @relation(fields: [userId], references: [id], onDelete: Cascade)
  session upward_session  @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, userId])
}

model upward_email_log {
  id        String    @id @default(uuid())
  userId    String
  email     String?
  sessionId String?
  subject   String
  type      String    @default("GENERIC") // CONFIRMATION, BULK, SESSION_INVITE, etc.
  status    String // SENT, FAILED
  body      String?   @db.Text
  mailgunId String?
  lastError String?
  retries   Int       @default(0)
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    upward_waitlist @relation(fields: [userId], references: [id], onDelete: Cascade)
  session upward_session? @relation(fields: [sessionId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@index([type])
}

model upward_admin {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String
  role               String             @default("ADMIN") // ADMIN, SUPERADMIN
  mustChangePassword Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  logs               upward_admin_log[]

  @@index([email])
}

model upward_admin_log {
  id        String   @id @default(uuid())
  adminId   String
  action    String // LOGIN, LOGOUT, EXPORT_CSV, SEND_EMAIL, ADD_ADMIN, DELETE_ADMIN, DEMOTE_ADMIN, DELETE_USER, etc.
  details   String? // Summary or JSON string: "Deleted 3 users", "Subject: Welcome Email"
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  admin upward_admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model upward_interaction {
  id        String   @id @default(uuid())
  visitorId String // Anonymous ID from localStorage
  type      String // CLICK, VIEW, SCROLL
  target    String // e.g. "HERO_CTA", "BENEFITS_SECTION"
  abVariant String // A or B
  ipAddress String?
  userAgent String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([visitorId])
  @@index([type])
  @@index([createdAt])
}

model upward_error_log {
  id        String   @id @default(uuid())
  message   String
  stack     String?
  context   String? // JSON string of request context (URL, Body, Params, etc.)
  severity  String   @default("ERROR") // ERROR, WARNING, INFO
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([severity])
  @@index([resolved])
}

model upward_email_campaign {
  id          String   @id @default(uuid())
  weekNumber  Int      @unique // 1, 2, 3, ... — which week in the drip sequence
  subject     String
  htmlContent String   @db.Text
  textContent String?  @db.Text
  label       String? // e.g. "Welcome to Upward", "Week 2: Housing Tips"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([weekNumber])
  @@index([isActive])
}

model upward_system_email {
  id          String   @id @default(uuid())
  slug        String   @unique // SIGNUP_CONFIRMATION, etc.
  subject     String
  htmlContent String   @db.Text
  textContent String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model upward_fairness_story {
  id         String   @id @default(uuid())
  name       String?
  categories String[]
  story      String   @db.Text
  audioUrl   String?
  fileUrls   String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
}

model upward_user {
  id           Int    @id @default(autoincrement())
  uuid         String @unique @default(uuid())
  passwordHash String

  email         String
  firstName     String
  lastName      String
  phone         String?
  emailHash     String  @unique
  firstNameHash String
  lastNameHash  String
  phoneHash     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rentEndDate          DateTime?
  occupation           String?
  gender               String?
  dateOfBirth          String?
  isFromWaitlist       Boolean   @default(false)
  isFromInvite         Boolean   @default(false)
  profileSlug          String?   @unique
  bio                  String?   @db.Text
  profilePic           String?
  resetPasswordOTP     String?
  resetPasswordExpires DateTime?

  announcementStates upward_user_announcement_state[]
  notifications      upward_notification[]
  paymentRequests    upward_payment_request[]

  companyUsers   upward_company_user[]
  properties     upward_user_property[]
  contracts      upward_user_contract[]
  authSessions   upward_auth_session[]
  supportTickets upward_support_ticket[]
  deviceTokens   upward_device_token[]
  overpayments   upward_overpayment[]

  @@index([email])
  @@index([createdAt])
}

model upward_device_token {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String // FCM / APNs token
  platform  String // android | ios | web
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user upward_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

model upward_support_ticket {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(uuid())
  userId     Int
  message    String    @db.Text
  status     String    @default("OPEN") // OPEN, RESOLVED
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user upward_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model upward_saved_landlord {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(uuid())
  userId        Int
  name          String
  accountName   String
  accountNumber String
  bankName      String
  bankCode      String
  lastAmount    Float?
  lastPaid      DateTime?
  subaccountId  Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subaccount upward_paystack_subaccount? @relation(fields: [subaccountId], references: [id])

  @@index([userId])
}

model upward_transaction {
  id              Int      @id @default(autoincrement())
  uuid            String   @unique @default(uuid())
  userId          Int
  type            String   @default("RENT") // RENT, SAVINGS, WALLET_DEPOSIT, WALLET_WITHDRAWAL, GOAL_ALLOCATION
  transactionType String   @default("PAYMENT") // PAYMENT, FUTURE_CREDIT
  status          String   @default("PENDING") // PENDING, SUCCESS, FAILED
  amount          Float
  currency        String   @default("NGN")
  reference       String   @unique
  narration       String?
  landlordId      String?
  paymentType     String?
  propertyAddress String?
  lineItems       Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  paymentRequestId Int?
  paymentRequest   upward_payment_request? @relation(fields: [paymentRequestId], references: [id])
  overpayments     upward_overpayment[]

  @@index([userId])
  @@index([reference])
  @@index([paymentRequestId])
}

model upward_announcement {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  title     String
  message   String   @db.Text
  iconType  String   @default("sparkles") // sparkles, clock, target, etc.
  url       String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states upward_user_announcement_state[]

  @@index([isActive])
  @@index([createdAt])
}

model upward_user_announcement_state {
  id               Int      @id @default(autoincrement())
  uuid             String   @unique @default(uuid())
  userId           Int
  announcementId   Int
  seenPopup        Boolean  @default(false)
  interactedPopup  Boolean  @default(false)
  seenBanner       Boolean  @default(false)
  interactedBanner Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  announcement upward_announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         upward_user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([userId])
}

model upward_notification {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  userId    Int
  title     String
  message   String   @db.Text
  type      String   @default("SYSTEM") // SYSTEM, SUPPORT, PAYMENT
  url       String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user upward_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model upward_payment_request {
  id             Int       @id @default(autoincrement())
  uuid           String    @unique @default(uuid())
  userId         Int
  userPropertyId Int?
  amount         Float
  currency       String    @default("NGN")
  description    String?
  dueDate        DateTime
  status         String    @default("PENDING") // PENDING, PARTIAL, PAID
  amountPaid     Float     @default(0)
  allowPartial   Boolean   @default(false)
  minAmount      Float?
  paidAt         DateTime?
  reference      String?   @unique
  subaccountId   Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user            upward_user               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    upward_transaction[]
  lineItemRecords upward_payment_line_item[]

  userProperty upward_user_property?       @relation(fields: [userPropertyId], references: [id])
  subaccount   upward_paystack_subaccount? @relation(fields: [subaccountId], references: [id])
  overpayments upward_overpayment[]

  @@index([userId])
  @@index([status])
}

model upward_payment_line_item {
  id               Int      @id @default(autoincrement())
  uuid             String   @unique @default(uuid())
  paymentRequestId Int
  label            String
  totalAmount      Float
  amountPaid       Float    @default(0)
  status           String   @default("PENDING") // PENDING, PARTIAL, PAID
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  paymentRequest upward_payment_request @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)

  @@index([paymentRequestId])
  @@index([status])
}

model upward_company {
  id         Int              @id @default(autoincrement())
  uuid       String           @unique @default(uuid())
  name       String
  address    String?
  email      String?
  phone      String?
  emailHash  String?          @unique
  phoneHash  String?
  nameHash   String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  platformId Int?
  platform   upward_platform? @relation(fields: [platformId], references: [id], onDelete: Cascade)

  companyUsers upward_company_user[]
  properties   upward_user_property[]
  managers     upward_manager[]
}

model upward_platform {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  apiKey     String   @unique
  webhookUrl String
  name       String
  address    String?
  email      String?
  emailHash  String?  @unique
  nameHash   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  companies   upward_company[]
  webhookLogs upward_webhook_log[]
}

model upward_company_user {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(uuid())
  companyId  Int
  userId     Int
  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?

  company upward_company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    upward_user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
}

model upward_manager {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  companyId     Int
  firstName     String? /// @encrypted
  lastName      String? /// @encrypted
  phone         String? /// @encrypted
  email         String? /// @encrypted
  emailHash     String?  @unique
  phoneHash     String?
  firstNameHash String?
  lastNameHash  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company    upward_company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  properties upward_user_property[]
}

model upward_location {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  country   String
  state     String
  area      String
  subarea   String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties upward_user_property[]
}

model upward_user_property {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(uuid())
  userId        Int
  companyId     Int?
  managerId     Int?
  locationId    Int?
  rentAmount    Float     @default(0)
  currency      String    @default("NGN")
  rentStartDate DateTime?
  rentEndDate   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     upward_user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company  upward_company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager  upward_manager?  @relation(fields: [managerId], references: [id])
  location upward_location? @relation(fields: [locationId], references: [id])

  paymentRequests upward_payment_request[]
  contracts       upward_user_contract[]
}

model upward_paystack_subaccount {
  id             Int      @id @default(autoincrement())
  uuid           String   @unique @default(uuid())
  accountNumber  String
  bankCode       String
  subaccountCode String   @unique
  businessName   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  paymentRequests upward_payment_request[]
  savedLandlords  upward_saved_landlord[]

  @@unique([accountNumber, bankCode])
  @@index([accountNumber, bankCode])
}

model upward_webhook_log {
  id           String    @id @default(uuid())
  platformId   Int
  event        String // e.g. payment.confirmed
  url          String
  payload      Json
  status       String // PENDING, SENT, FAILED
  responseCode Int?
  errorMessage String?
  retries      Int       @default(0)
  lastTriedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  platform upward_platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId])
  @@index([status])
  @@index([createdAt])
}

model upward_user_contract {
  id             Int      @id @default(autoincrement())
  uuid           String   @unique @default(uuid())
  userId         Int
  userPropertyId Int?
  fileName       String
  fileUrl        String // The S3 Key
  fileType       String // mime type
  fileSize       Int // in bytes
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         upward_user           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userProperty upward_user_property? @relation(fields: [userPropertyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userPropertyId])
}

model upward_auth_session {
  id               String   @id @default(uuid())
  userId           Int
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  deviceId         String?
  isRevoked        Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user upward_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
}

model upward_overpayment {
  id               Int      @id @default(autoincrement())
  uuid             String   @unique @default(uuid())
  userId           Int
  amount           Float
  currency         String   @default("NGN")
  transactionId    Int?
  paymentRequestId Int?
  status           String   @default("AVAILABLE") // AVAILABLE, APPLIED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           upward_user             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction    upward_transaction?     @relation(fields: [transactionId], references: [id])
  paymentRequest upward_payment_request? @relation(fields: [paymentRequestId], references: [id])

  @@index([userId])
}
